<Application x:Class="MedicalShopDiaShop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MedicalShopDiaShop"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="/MainView/AuthorizationWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Pink" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="GothamProFamily">
                /Fonts/gothampro.ttf#Gotham Pro,
                /Fonts/gothampro_bold.ttf#Gotham Pro,
                /Fonts/gothampro_italic.ttf#Gotham Pro,
                /Fonts/gothampro_bolditalic.ttf#Gotham Pro,
                /Fonts/gothampro_light.ttf#Gotham Pro,
                /Fonts/gothampro_lightitalic.ttf#Gotham Pro,
                /Fonts/gothampro_medium.ttf#Gotham Pro,
                /Fonts/gothampro_mediumitalic.ttf#Gotham Pro
            </FontFamily>
            
            <FontFamily x:Key="GothamProLight">/Fonts/gothampro_light.ttf#Gotham Pro</FontFamily>

            <!-- Основной цвет приложения (Deep Purple, как в BundledTheme) -->
            <SolidColorBrush x:Key="AppPrimaryBrush" Color="#673AB7"/>
            <SolidColorBrush x:Key="AppPrimaryDarkBrush" Color="#512DA8"/>
            <SolidColorBrush x:Key="AppPrimaryForegroundBrush" Color="White"/>

            <Style TargetType="{x:Type Calendar}">
                <Setter Property="Language" Value="ru-RU"/>
            </Style>
            <Style TargetType="{x:Type DatePicker}">
                <Setter Property="Language" Value="ru-RU"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>

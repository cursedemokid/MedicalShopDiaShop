<Window x:Class="MedicalShopDiaShop.AppData.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="CustomMessageBox" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="300"
        MaxWidth="500">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Иконка и заголовок -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <materialDesign:PackIcon Name="Icon" Kind="Information" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Name="TitleText" Text="Заголовок" FontSize="22" FontWeight="Bold" 
                       FontFamily="{StaticResource GothamProFamily}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Текст сообщения -->
        <TextBlock Name="MessageText" Grid.Row="1" Text="Текст сообщения" 
                   FontSize="16" FontFamily="{StaticResource GothamProFamily}"
                   TextWrapping="Wrap" Margin="0,0,0,20"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="YesButton" Content="Да" Width="80" Height="35" Margin="0,0,10,0"
                    Style="{StaticResource MaterialDesignFlatButton}" 
                    Click="YesButton_Click" Visibility="Collapsed"/>
            <Button Name="NoButton" Content="Нет" Width="80" Height="35" Margin="0,0,10,0"
                    Style="{StaticResource MaterialDesignFlatButton}" 
                    Click="NoButton_Click" Visibility="Collapsed"/>
            <Button Name="OkButton" Content="ОК" Width="80" Height="35"
                    Style="{StaticResource MaterialDesignFlatButton}" 
                    Click="OkButton_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
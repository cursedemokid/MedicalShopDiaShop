<Window x:Class="MedicalShopDiaShop.MainView.AddEditSupplierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Height="720" Width="1280" MinWidth="500" MinHeight="232" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid>
        <Image Source="/Resources/BackgroundPatternPurple.png" Stretch="Fill"/>

        <Border CornerRadius="20" BorderThickness="1" BorderBrush="White" Background="White" 
                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
            <Grid Width="500">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Добавление поставщика" 
                           FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="{StaticResource GothamProFamily}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Название" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                <Border Grid.Row="2" Grid.Column="2" BorderThickness="1" BorderBrush="Black" CornerRadius="3">
                    <TextBox x:Name="NameTb" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                </Border>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Адрес" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                <Border Grid.Row="4" Grid.Column="2" BorderThickness="1" BorderBrush="Black" CornerRadius="3">
                    <TextBox x:Name="AddressTb" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                </Border>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Город" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                <Border Grid.Row="6" Grid.Column="2" BorderThickness="1" BorderBrush="Black" CornerRadius="3">
                    <ComboBox x:Name="CityComboBox" FontSize="20"
                          DisplayMemberPath="Name" SelectedValuePath="Id" FontFamily="{StaticResource GothamProFamily}"/>
                </Border>

                <Grid Grid.Row="8" Grid.ColumnSpan="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" x:Name="SaveBtn" Content="Сохранить" Height="33" 
                            Click="SaveBtn_Click" Margin="10" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                    <Button Grid.Column="3" x:Name="CancelBtn" Content="Отмена" Height="33" 
                            Click="CancelBtn_Click" Margin="10" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
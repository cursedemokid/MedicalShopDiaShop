<Window x:Class="MedicalShopDiaShop.MainView.SupplyDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детали поставки" Height="600" Width="800"
        WindowStartupLocation="CenterOwner" MinHeight="400" MinWidth="600">
    <Grid>
        <Image Source="/Resources/BackgroundPatternPurple.png" Stretch="Fill"/>

        <Border CornerRadius="20" BorderThickness="1" BorderBrush="White" Background="White"
                Margin="20" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <TextBlock x:Name="TitleText" Text="Поставка №0" FontSize="24" FontWeight="Bold"
                               FontFamily="{StaticResource GothamProFamily}" HorizontalAlignment="Center"/>

                    <!-- Информация о поставке -->
                    <Border Grid.Row="2" CornerRadius="15" Background="#F5F5F5" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Поставщик:" FontWeight="Bold" FontSize="16" FontFamily="{StaticResource GothamProFamily}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="SupplierText" FontSize="16" FontFamily="{StaticResource GothamProLight}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Дата заказа:" FontWeight="Bold" FontSize="16" FontFamily="{StaticResource GothamProFamily}"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="OrderDateText" FontSize="16" FontFamily="{StaticResource GothamProLight}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Ожидаемая дата:" FontWeight="Bold" FontSize="16" FontFamily="{StaticResource GothamProFamily}"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" x:Name="AroundDateText" FontSize="16" FontFamily="{StaticResource GothamProLight}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Общая сумма:" FontWeight="Bold" FontSize="16" FontFamily="{StaticResource GothamProFamily}"/>
                            <TextBlock Grid.Row="6" Grid.Column="2" x:Name="TotalText" FontSize="16" FontFamily="{StaticResource GothamProLight}" Foreground="#4CAF50"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Фактическая дата:" FontWeight="Bold" FontSize="16" FontFamily="{StaticResource GothamProFamily}"/>
                            <TextBlock Grid.Row="8" Grid.Column="2" x:Name="ArrivedDateText" FontSize="16" FontFamily="{StaticResource GothamProLight}"/>

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Отклонение:" FontWeight="Bold" FontSize="16" FontFamily="{StaticResource GothamProFamily}"/>
                            <TextBlock Grid.Row="10" Grid.Column="2" x:Name="DeviationText" FontSize="16" FontFamily="{StaticResource GothamProLight}"/>
                        </Grid>
                    </Border>

                    <!-- Товары -->
                    <Border Grid.Row="4" CornerRadius="15" Background="#F5F5F5" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Товары" FontSize="18" FontWeight="Bold" FontFamily="{StaticResource GothamProFamily}"/>

                            <ItemsControl Grid.Row="2" x:Name="ProductsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Background="White" Margin="0,5" Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding Image}" Width="50" Height="50"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="16" FontFamily="{StaticResource GothamProFamily}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Quantity, StringFormat='Кол-во: {0}'}" FontSize="16" FontFamily="{StaticResource GothamProLight}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" VerticalAlignment="Center">
                                                    <Run Text="Цена/1: " FontSize="16" FontFamily="{StaticResource GothamProFamily}"/>
                                                    <Run Text="{Binding PricePerUnit, StringFormat={}{0:N2}}" FontSize="16" FontFamily="{StaticResource GothamProLight}"/>
                                                    <Run Text=" ₽" FontSize="16" FontFamily="{StaticResource GothamProLight}"/>
                                                </TextBlock>
                                                <TextBlock Grid.Column="7" VerticalAlignment="Center">
                                                    <Run Text="Итог: " FontSize="16" FontFamily="{StaticResource GothamProFamily}"/>
                                                    <Run Text="{Binding TotalPrice, StringFormat={}{0:N2}}" FontSize="16" FontFamily="{StaticResource GothamProLight}"/>
                                                    <Run Text=" ₽" FontSize="16" FontFamily="{StaticResource GothamProLight}"/>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Button Grid.Row="6" x:Name="MarkArrivedBtn" Content="Принять поставку"
                            Width="180" Height="36" HorizontalAlignment="Center"
                            FontFamily="{StaticResource GothamProFamily}"
                            Click="MarkArrivedBtn_Click"/>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
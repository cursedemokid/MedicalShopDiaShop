<Page x:Class="MedicalShopDiaShop.MainView.Pages.ClientsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:MedicalShopDiaShop.MainView.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="694" d:DesignWidth="1033"
      Title="ClientsPage">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="10" />
            <RowDefinition Height="100" />
            <RowDefinition Height="10" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1">
                <controls:SearchBarControl x:Name="PageSearchBar"
                                          Width="400"
                                          HorizontalAlignment="Left"
                                          PlaceholderText="Поиск по клиентам"
                                          FilterTextChanged="PageSearchBar_FilterTextChanged"
                                          SearchClicked="SearchBtn_Click"/>
            </Grid>

            <Button Name="AddBtn" Grid.Column="3" Content="Добавить" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Click="AddBtn_Click" Height="50"/>
            <Button Name="EditBtn" Grid.Column="5" Content="Изменить" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Click="EditBtn_Click" Height="50"/>
            <Button Name="DeleteBtn" Grid.Column="7" Content="Удалить" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Click="DeleteBtn_Click" Height="50"/>
        </Grid>

        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>


            <Grid Grid.Column="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Button Name="ListBoxOnBtn" Grid.Column="2" Background="White" Padding="5" BorderThickness="0" Height="50" Click="ListBoxOnBtn_Click">
                    <Button.Content>
                        <Image Source="/Resources/dots.png" Width="70"/>
                    </Button.Content>
                </Button>
                <Button Name="ListViewOnBtn" Background="White" Padding="5" BorderThickness="0" Height="50" Click="ListViewOnBtn_Click">
                    <Button.Content>
                        <Image Source="/Resources/menu.png" Width="70"/>
                    </Button.Content>
                </Button>
            </Grid>
        </Grid>

        <Grid Grid.Row="4" Margin="10">
            <ListView Name="ClientsListView" 
                      Visibility="Visible" 
                      FontSize="20" 
                      FontFamily="{StaticResource GothamProFamily}"
                      AlternationCount="2"
                      SelectionMode="Single">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="ФИО" DisplayMemberBinding="{Binding FullName}" Width="auto"/>
                        <GridViewColumn Header="Логин" DisplayMemberBinding="{Binding UserName}" Width="auto"/>
                        <GridViewColumn Header="Телефон" DisplayMemberBinding="{Binding PhoneNumber}" Width="auto"/>
                        <GridViewColumn Header="Email" DisplayMemberBinding="{Binding Email}" Width="200"/>
                        <GridViewColumn Width="auto">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Подробнее" 
                                            FontSize="16" 
                                            FontFamily="{StaticResource GothamProFamily}"
                                            Click="Details_Click" 
                                            Tag="{Binding}"
                                            Margin="5,2"
                                            Width="150"
                                            HorizontalContentAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <ListBox Name="ClientsListBox" 
                     Visibility="Collapsed" 
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" IsItemsHost="True" Margin="0"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="30" 
                                Background="White" 
                                Margin="10" 
                                Width="300"
                                Height="450"
                                BorderBrush="LightGray"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.25" Color="Gray"/>
                            </Border.Effect>
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,5,10,0"/>
                                    <StackPanel Grid.ColumnSpan="2">
                                        <Image Source="{Binding AvatarKey}" Height="100" Width="100" />
                                        <TextBlock Text="{Binding UserName}" FontSize="20" FontFamily="{StaticResource GothamProFamily}" TextAlignment="Center"/>
                                        <Separator/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <StackPanel>
                                        <TextBlock Text="ФИО" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                                        <TextBlock Text="{Binding FullName}" FontSize="20" FontFamily="{StaticResource GothamProLight}" TextWrapping="Wrap"/>
                                        <TextBlock Text="Телефон" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                                        <TextBlock Text="{Binding PhoneNumber}" FontSize="20" FontFamily="{StaticResource GothamProLight}" TextWrapping="Wrap"/>
                                        <TextBlock Text="Email" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                                        <TextBlock Text="{Binding Email}" FontSize="20" FontFamily="{StaticResource GothamProLight}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>

                                <Button Grid.Row="4" Content="Подробнее" FontSize="16" FontFamily="{StaticResource GothamProFamily}"
                                        Click="Details_Click" Tag="{Binding}" Margin="0,0,0,20" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Page>
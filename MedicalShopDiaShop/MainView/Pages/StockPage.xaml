<Page x:Class="MedicalShopDiaShop.MainView.Pages.StockPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:MedicalShopDiaShop.MainView.Controls"
      Title="Склад" Background="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <controls:SearchBarControl x:Name="PageSearchBar"
                                 MaxWidth="520"
                                 HorizontalAlignment="Left"
                                 PlaceholderText="Поиск по товару..."
                                 FilterTextChanged="PageSearchBar_FilterTextChanged"
                                 SearchClicked="PageSearchBar_SearchClicked"/>
        <ListView x:Name="StockListView" Grid.Row="2" FontSize="16">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Товар" DisplayMemberBinding="{Binding ProductName}" Width="250"/>
                    <GridViewColumn Header="Срок годности" DisplayMemberBinding="{Binding ExpirationDate, StringFormat='dd.MM.yyyy'}" Width="120"/>
                    <GridViewColumn Header="Остаток" DisplayMemberBinding="{Binding Available}" Width="80"/>
                    <GridViewColumn Header="Статус" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>

<Page x:Class="MedicalShopDiaShop.MainView.Pages.StockPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Склад" Background="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="SearchBox" Width="300" Height="35" FontSize="16" Text="Поиск по товару..."/>
        <ListView x:Name="StockListView" Grid.Row="2" FontSize="16">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Товар" DisplayMemberBinding="{Binding ProductName}" Width="250"/>
                    <GridViewColumn Header="Срок годности" DisplayMemberBinding="{Binding ExpirationDate, StringFormat='dd.MM.yyyy'}" Width="120"/>
                    <GridViewColumn Header="Остаток" DisplayMemberBinding="{Binding Available}" Width="80"/>
                    <GridViewColumn Header="Статус" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>
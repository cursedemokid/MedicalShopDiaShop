<Page x:Class="MedicalShopDiaShop.MainView.Pages.SuppliersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="694" d:DesignWidth="1033"
      Title="SuppliersPage">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="10" />
            <RowDefinition Height="100" />
            <RowDefinition Height="10" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель: поиск + кнопки действий -->
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Width="400" Height="50" FontSize="20" 
                         FontFamily="{StaticResource GothamProFamily}" 
                         TextChanged="SearchBox_TextChanged"/>
                <Button Grid.Column="2" Padding="2" Height="50" Background="White" 
                        BorderBrush="White" Click="SearchBtn_Click">
                    <Button.Content>
                        <Image Source="/Resources/search.png"/>
                    </Button.Content>
                </Button>
            </Grid>

            <Button Name="AddBtn" Grid.Column="3" Content="Добавить" FontSize="20" 
                    FontFamily="{StaticResource GothamProFamily}" Click="AddBtn_Click" Height="50"/>
            <Button Name="EditBtn" Grid.Column="5" Content="Изменить" FontSize="20" 
                    FontFamily="{StaticResource GothamProFamily}" Click="EditBtn_Click" Height="50"/>
            <Button Name="DeleteBtn" Grid.Column="7" Content="Удалить" FontSize="20" 
                    FontFamily="{StaticResource GothamProFamily}" Click="DeleteBtn_Click" Height="50" Cursor="Hand"/>
        </Grid>

        <!-- Панель фильтрации и переключения режимов -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Кнопки переключения режима -->
            <Button x:Name="SuppliersModeBtn" Grid.Column="0" Content="Поставщики" 
                    FontSize="20" FontFamily="{StaticResource GothamProFamily}" Height="50"
                    Click="SuppliersModeBtn_Click" Style="{StaticResource MaterialDesignFlatButton}"/>
            <Button x:Name="SuppliesModeBtn" Grid.Column="2" Content="Поставки" 
                    FontSize="20" FontFamily="{StaticResource GothamProFamily}" Height="50"
                    Click="SuppliesModeBtn_Click" Style="{StaticResource MaterialDesignFlatButton}"/>

            <!-- Фильтр по городу (только для режима поставщиков) -->
            <GroupBox x:Name="CityFilterGroup" Grid.Column="5" Style="{x:Null}" BorderBrush="Black" BorderThickness="2">
                <GroupBox.Header>
                    <TextBlock Text="Город" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                </GroupBox.Header>
                <ComboBox Name="CityFilterComboBox" Width="200" FontSize="20" 
                          FontFamily="{StaticResource GothamProFamily}"
                          SelectionChanged="CityFilterComboBox_SelectionChanged"/>
            </GroupBox>
        </Grid>

        <!-- Область отображения поставщиков (ListView) -->
        <ListView x:Name="SuppliersListView" Grid.Row="4" Margin="10"
                  Visibility="Visible" FontSize="20" FontFamily="{StaticResource GothamProFamily}"
                  AlternationCount="2" SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="40">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Name}" Width="250"/>
                    <GridViewColumn Header="Адрес" DisplayMemberBinding="{Binding Address}" Width="300"/>
                    <GridViewColumn Header="Город" DisplayMemberBinding="{Binding CityName}" Width="150"/>
                    <GridViewColumn Width="auto">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Подробнее" FontSize="16" FontFamily="{StaticResource GothamProFamily}"
                                        Click="Details_Click" Tag="{Binding}" Margin="5,2" Width="150"
                                        HorizontalContentAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Область отображения поставок (ListBox с карточками) -->
        <ListBox x:Name="SuppliesListBox" Grid.Row="4" Margin="10"
                 Visibility="Collapsed" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" IsItemsHost="True" Margin="0"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- Карточка поставки -->
                    <Border CornerRadius="20" Background="White" Margin="10" Width="350"
        BorderBrush="LightGray" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.2" Color="Gray"/>
                        </Border.Effect>
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="18" FontWeight="Bold"
                       FontFamily="{StaticResource GothamProFamily}" TextWrapping="Wrap"/>
                            </Grid>
                            <Separator Grid.Row="1"/>

                            <TextBlock Grid.Row="2" Text="{Binding SupplierName}" FontSize="16" 
                   FontFamily="{StaticResource GothamProLight}"/>

                            <TextBlock Grid.Row="4" Text="Дата заказа:" FontSize="14" FontFamily="{StaticResource GothamProFamily}"/>
                            <TextBlock Grid.Row="5" Text="{Binding OrderDate, StringFormat='dd.MM.yyyy'}" FontSize="14" 
                   FontFamily="{StaticResource GothamProLight}"/>

                            <TextBlock Grid.Row="6" Text="Ожидаемая дата:" FontSize="14" FontFamily="{StaticResource GothamProFamily}"/>
                            <TextBlock Grid.Row="7" Text="{Binding AroundDate, StringFormat='dd.MM.yyyy'}" FontSize="14" 
                   FontFamily="{StaticResource GothamProLight}"/>

                            <TextBlock Grid.Row="8" Text="Сумма:" FontSize="14" FontFamily="{StaticResource GothamProFamily}"/>
                            <TextBlock Grid.Row="9" Text="{Binding TotalCost, StringFormat='{}{0:N2} ₽'}" FontSize="14" 
                   FontFamily="{StaticResource GothamProLight}"/>

                            <Button Grid.Row="10" Content="Подробнее" Margin="0,15,0,0"
                FontSize="14" FontFamily="{StaticResource GothamProFamily}"
                Click="ViewSupplyDetails_Click" Tag="{Binding}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
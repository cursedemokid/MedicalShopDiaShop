<Page x:Class="MedicalShopDiaShop.MainView.Pages.SuppliersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="694" d:DesignWidth="1033"
      Title="SuppliersPage">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="10" />
            <RowDefinition Height="100" />
            <RowDefinition Height="10" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель: поиск + кнопки действий -->
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Width="400" Height="50" FontSize="20" 
                         FontFamily="{StaticResource GothamProFamily}" />
                <Button Grid.Column="2" Padding="2" Height="50" Background="White" 
                        BorderBrush="White" Click="SearchBtn_Click">
                    <Button.Content>
                        <Image Source="/Resources/search.png"/>
                    </Button.Content>
                </Button>
            </Grid>

            <Button Name="AddBtn" Grid.Column="3" Content="Добавить" FontSize="20" 
                    FontFamily="{StaticResource GothamProFamily}" Click="AddBtn_Click" Height="50"/>
            <Button Name="EditBtn" Grid.Column="5" Content="Изменить" FontSize="20" 
                    FontFamily="{StaticResource GothamProFamily}" Click="EditBtn_Click" Height="50"/>
            <Button Name="DeleteBtn" Grid.Column="7" Content="Удалить" FontSize="20" 
                    FontFamily="{StaticResource GothamProFamily}" Click="DeleteBtn_Click" Height="50"/>
        </Grid>

        <!-- Панель фильтрации (пока только заглушка) -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <!-- Можно добавить фильтр по городу, но пока оставим пустым -->
            <GroupBox Grid.Column="1" Style="{x:Null}" BorderBrush="Black" BorderThickness="2">
                <GroupBox.Header>
                    <TextBlock Text="Город" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                </GroupBox.Header>
                <ComboBox Name="CityFilterComboBox" Width="200" FontSize="20" 
                          FontFamily="{StaticResource GothamProFamily}"
                          SelectionChanged="CityFilterComboBox_SelectionChanged"/>
            </GroupBox>
        </Grid>

        <!-- Область отображения поставщиков (только ListView) -->
        <Grid Grid.Row="4" Margin="10">
            <ListView Name="SuppliersListView" 
                      Visibility="Visible" 
                      FontSize="20" 
                      FontFamily="{StaticResource GothamProFamily}"
                      AlternationCount="2"
                      SelectionMode="Single">
                <ListView.View>
                    <GridView>
                        <!-- Колонка с чекбоксом для выделения -->
                        <GridViewColumn Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <!-- Название -->
                        <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Name}" Width="250"/>
                        <!-- Адрес -->
                        <GridViewColumn Header="Адрес" DisplayMemberBinding="{Binding Address}" Width="300"/>
                        <!-- Город -->
                        <GridViewColumn Header="Город" DisplayMemberBinding="{Binding CityName}" Width="150"/>
                        <!-- Кнопка "Подробнее" -->
                        <GridViewColumn Width="auto">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Подробнее" 
                                            FontSize="16" 
                                            FontFamily="{StaticResource GothamProFamily}"
                                            Click="Details_Click" 
                                            Tag="{Binding}"
                                            Margin="5,2"
                                            Width="150"
                                            HorizontalContentAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</Page>
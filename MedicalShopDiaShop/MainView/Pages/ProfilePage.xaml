<Page x:Class="MedicalShopDiaShop.MainView.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MedicalShopDiaShop.MainView.Pages"
      xmlns:behaviors="clr-namespace:MedicalShopDiaShop.AppData"
      xmlns:controls="clr-namespace:MedicalShopDiaShop.MainView.Controls"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="694" d:DesignWidth="1033" d:MaxWidth="1125"
      Title="ProfilePage">

    <Grid Background="White" Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="29*"/>
            <RowDefinition Height="7*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- Левая колонка: личная информация -->
        <Border CornerRadius="30" Background="White" Margin="10,10,10,10" Grid.RowSpan="2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.25" Color="Gray"/>
            </Border.Effect>
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="10" />
                </Grid.RowDefinitions>

                <!-- Аватар -->
                <Image x:Name="AvatarImage" Height="200" Width="200">
                    <Image.Clip>
                        <EllipseGeometry Center="100,100" RadiusX="100" RadiusY="100"/>
                    </Image.Clip>
                </Image>

                <TextBlock x:Name="UserNameTextBlock" Grid.Row="2" Text="" FontSize="20" FontFamily="{StaticResource GothamProFamily}" HorizontalAlignment="Center"/>
                <Separator Grid.Row="3"/>

                <TextBlock Grid.Row="4" Text="ФИО" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                <TextBlock x:Name="FullNameTextBlock" Grid.Row="6" Text="" FontSize="20" FontFamily="{StaticResource GothamProLight}" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="8" Text="Роль" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                <TextBlock x:Name="RoleTextBlock" Grid.Row="10" Text="" FontSize="20" FontFamily="{StaticResource GothamProLight}" FontWeight="Light" TextWrapping="Wrap"/>

                <!-- Блок для сотрудника (магазин) -->
                <TextBlock Grid.Row="12" Name="EmployeeTextBlock" Text="Магазин" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                <TextBlock x:Name="StoreTextBlock" Grid.Row="14" Text="" FontSize="20" FontFamily="{StaticResource GothamProLight}" FontWeight="Light" TextWrapping="Wrap"/>

                <!-- Блок для клиента (адрес) -->
                <TextBlock Grid.Row="12" Name="ClientTextBlock" Text="Адрес" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Margin="0,10,0,0"/>
                <TextBlock x:Name="AddressTextBlock" Grid.Row="14" Text="" FontSize="20" FontFamily="{StaticResource GothamProLight}" FontWeight="Light" TextWrapping="Wrap"/>

                <!-- Кнопки -->
                <Button x:Name="ChangeAvatarButton" Grid.Row="18" Content="Сменить аватар" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Click="ChangeAvatar_Click" Margin="0,10,0,0"/>
                <Button x:Name="ChangePasswordButton" Grid.Row="20" Content="Сменить пароль" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Click="ChangePassword_Click"/>
            </Grid>
        </Border>

        <!-- Правая колонка для клиента (история покупок) -->
        <Grid Name="ClientProfileGrid" Grid.Column="2" Grid.RowSpan="2" Visibility="Hidden">
            <Border CornerRadius="30" Background="White" Margin="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.25" Color="Gray"/>
                </Border.Effect>
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="История покупок" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                    <!-- Фильтры и поиск -->
                    <Grid Grid.Row="2" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <controls:SearchBarControl x:Name="HistorySearchBar"
                                                      MinWidth="160"
                                                      PlaceholderText="Поиск по товарам"
                                                      FilterTextChanged="HistorySearchBar_FilterTextChanged"
                                                      SearchClicked="HistorySearch_Click"/>
                        </Grid>
                        <GroupBox Grid.Column="2" Header="Сортировать по" Style="{x:Null}" BorderThickness="2" BorderBrush="Black" FontSize="20" FontFamily="{StaticResource GothamProFamily}">
                            <ComboBox Name="OrderByCmb" SelectionChanged="OrderByCmb_SelectionChanged">
                                <ComboBoxItem Content="Дате" Tag="Date"/>
                                <ComboBoxItem Content="Цене" Tag="Cost"/>
                                <ComboBoxItem Content="Нет" Tag="None"/>
                            </ComboBox>
                        </GroupBox>
                        <GroupBox Grid.Column="4" Header="Дата" Style="{x:Null}" BorderThickness="2" BorderBrush="Black" FontSize="20" FontFamily="{StaticResource GothamProFamily}">
                            <DatePicker x:Name="HistoryDateFilter" FontSize="20" Width="150" Language="Ru" SelectedDateChanged="HistoryDateFilter_SelectedDateChanged"/>
                        </GroupBox>
                    </Grid>
                    <ListBox Name="HistoryListBox" Grid.Row="4">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="30" Background="White" Margin="10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.25" Color="Gray"/>
                                    </Border.Effect>
                                    <Grid Margin="20">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Товар" FontFamily="{StaticResource GothamProFamily}" FontSize="14" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="2" Text="Цена за 1" FontFamily="{StaticResource GothamProFamily}" FontSize="14" FontWeight="Bold" Margin="0,0,20,0"/>
                                            <TextBlock Grid.Column="3" Text="Цена всего" FontFamily="{StaticResource GothamProFamily}" FontSize="14" FontWeight="Bold" Margin="20,0,0,0"/>
                                        </Grid>
                                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Image Source="{Binding ImageSource}" Width="40" Height="40" Grid.Column="0"/>
                                                        <TextBlock Text="{Binding Quantity, StringFormat='x{}{0}'}" Grid.Column="2" FontFamily="{StaticResource GothamProLight}" FontSize="16" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" Grid.Column="4" FontFamily="{StaticResource GothamProLight}" FontSize="16" VerticalAlignment="Center" TextWrapping="Wrap" Margin="5,0"/>
                                                        <TextBlock Grid.Column="5" FontFamily="{StaticResource GothamProLight}" FontSize="16" VerticalAlignment="Center" Margin="0,0,20,0">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0:N2} ₽">
                                                                    <Binding Path="PricePerUnit"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="6" FontFamily="{StaticResource GothamProLight}" FontSize="16" VerticalAlignment="Center" Margin="20,0,0,0">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0:N2} ₽">
                                                                    <Binding Path="TotalPrice"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid Grid.Row="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Content="Подробно" FontFamily="{StaticResource GothamProFamily}" FontSize="16" Padding="10,5" Command="{Binding ViewDetailsCommand}"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                                <TextBlock Text="Дата:" FontFamily="{StaticResource GothamProFamily}" FontSize="14" FontWeight="Bold" Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding OrderDate, StringFormat='{}{0:dd.MM.yyyy}'}" FontFamily="{StaticResource GothamProLight}" FontSize="14"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Итого:" FontFamily="{StaticResource GothamProFamily}" FontSize="14" FontWeight="Bold" Margin="0,0,5,0"/>
                                                <TextBlock FontFamily="{StaticResource GothamProLight}" FontSize="14">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0:N2} ₽">
                                                            <Binding Path="TotalOrderPrice"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Правая колонка для сотрудника (вкладки: смены / задачи) -->
        <Grid Grid.Column="2" Name="EmployeeProfileGrid" Visibility="Visible" Grid.RowSpan="2">
            <Border CornerRadius="30" Background="White" Margin="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.25" Color="Gray"/>
                </Border.Effect>
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Вкладки в стиле браузера -->
                    <Border Grid.Row="0" Background="#EDE7F6" CornerRadius="16,16,0,0" Padding="8,8,8,0" Margin="0,0,0,-1">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="ScheduleTabHeader" Background="White" CornerRadius="12,12,0,0"
                                    Padding="22,10" Margin="0,0,4,0" Cursor="Hand"
                                    MouseLeftButtonUp="ScheduleTabHeader_Click"
                                    BorderBrush="{StaticResource AppPrimaryBrush}" BorderThickness="0,0,0,3">
                                <TextBlock x:Name="ScheduleTabHeaderText" Text="Смены"
                                           FontFamily="{StaticResource GothamProFamily}" FontSize="16"/>
                            </Border>
                            <Border x:Name="TasksTabHeader" Background="Transparent" CornerRadius="12,12,0,0"
                                    Padding="22,10" Cursor="Hand"
                                    MouseLeftButtonUp="TasksTabHeader_Click"
                                    BorderBrush="Transparent" BorderThickness="0,0,0,3">
                                <TextBlock x:Name="TasksTabHeaderText" Text="Задачи"
                                           FontFamily="{StaticResource GothamProFamily}" FontSize="16" Foreground="#666"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Вкладка: смены -->
                    <Grid x:Name="ScheduleTabPanel" Grid.Row="1" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AddScheduleBtn" Grid.Column="1" Content="Добавить"
                                    FontSize="14" Click="AddScheduleBtn_Click" Visibility="Collapsed"/>
                            <Button x:Name="EditScheduleBtn" Grid.Column="3" Content="Изменить"
                                    FontSize="14" Click="EditScheduleBtn_Click" Visibility="Collapsed"/>
                            <Button x:Name="DeleteScheduleBtn" Grid.Column="5" Content="Удалить"
                                    FontSize="14" Click="DeleteScheduleBtn_Click" Visibility="Collapsed"/>
                        </Grid>

                        <Calendar Name="ScheduleCalendar" Grid.Row="2"
                                  FontFamily="{StaticResource GothamProLight}"
                                  HorizontalAlignment="Stretch"
                                  materialDesign:ElevationAssist.Elevation="Dp2"
                                  behaviors:CalendarScheduleBehavior.ScheduledDates="{Binding ScheduledDates}"
                                  behaviors:CalendarScheduleBehavior.DateToolTipSelector="{Binding ScheduleToolTipSelector}"
                                  SelectedDatesChanged="ScheduleCalendar_SelectedDatesChanged"/>

                        <TextBlock Grid.Row="4" Text="Смены на выбранную дату:" FontSize="16" FontFamily="{StaticResource GothamProFamily}"/>
                        <ListBox x:Name="SchedulesListBox" Grid.Row="6" MaxHeight="160" FontSize="16" FontFamily="{StaticResource GothamProFamily}"
                                 SelectionMode="Single" DisplayMemberPath="DisplayText"/>
                    </Grid>

                    <!-- Вкладка: задачи -->
                    <Grid x:Name="TasksTabPanel" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AddTaskBtn" Grid.Column="1" Content="Добавить"
                                    FontSize="14" Click="AddTaskBtn_Click" Visibility="Collapsed"/>
                            <Button x:Name="EditTaskBtn" Grid.Column="3" Content="Изменить"
                                    FontSize="14" Click="EditTaskBtn_Click" Visibility="Collapsed"/>
                            <Button x:Name="DeleteTaskBtn" Grid.Column="5" Content="Удалить"
                                    FontSize="14" Click="DeleteTaskBtn_Click" Visibility="Collapsed"/>
                        </Grid>

                        <ListBox x:Name="TasksListBox" Grid.Row="2">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" IsItemsHost="True" Margin="0"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="20" Background="White" Margin="10" MinWidth="240" MaxWidth="320"
                                        BorderBrush="LightGray" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.2" Color="Gray"/>
                                    </Border.Effect>
                                    <Grid Margin="15">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding IsChosen, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Checked="TaskSelectCheckBox_Checked"
                                                      Unchecked="TaskSelectCheckBox_Unchecked"/>
                                            <TextBlock Text="Выбрать" FontFamily="{StaticResource GothamProFamily}"
                                                       FontSize="14" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="2" Text="{Binding Title}" FontFamily="{StaticResource GothamProFamily}"
                                                   FontSize="18" TextWrapping="Wrap"/>
                                        <StackPanel Grid.Row="4" Orientation="Horizontal">
                                            <TextBlock Text="Начало: " FontFamily="{StaticResource GothamProFamily}" FontSize="14"/>
                                            <TextBlock Text="{Binding StartDate, StringFormat='{}{0:dd.MM.yyyy}'}"
                                                       FontFamily="{StaticResource GothamProLight}" FontSize="14" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="6" Orientation="Horizontal">
                                            <TextBlock Text="Дедлайн: " FontFamily="{StaticResource GothamProFamily}" FontSize="14"/>
                                            <TextBlock Text="{Binding Deadline, StringFormat='{}{0:dd.MM.yyyy}'}"
                                                       FontFamily="{StaticResource GothamProLight}" FontSize="14" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="Автор: " FontFamily="{StaticResource GothamProFamily}" FontSize="14"/>
                                            <TextBlock Text="{Binding AuthorName}" FontFamily="{StaticResource GothamProLight}" FontSize="14" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="10" Orientation="Horizontal" Margin="0,12,0,0">
                                            <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Checked="TaskCheckBox_Checked" Unchecked="TaskCheckBox_Unchecked"/>
                                            <TextBlock Text="Выполнено" FontFamily="{StaticResource GothamProFamily}"
                                                       FontSize="14" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button x:Name="PrevTasksBtn" Content="◀" FontSize="10" Width="40" Click="PrevTasksBtn_Click" Margin="5"/>
                            <TextBlock x:Name="TasksPageText" Text="1 / 1" VerticalAlignment="Center" Margin="10,0" FontSize="14"/>
                            <Button x:Name="NextTasksBtn" Content="▶" FontSize="10" Width="40" Click="NextTasksBtn_Click" Margin="5"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
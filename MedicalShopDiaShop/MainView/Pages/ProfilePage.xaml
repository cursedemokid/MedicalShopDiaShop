<Page x:Class="MedicalShopDiaShop.MainView.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MedicalShopDiaShop.MainView.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="694" d:DesignWidth="1033" d:MaxWidth="1125"
      Title="ProfilePage">

    <Grid Background="White" Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="29*"/>
            <RowDefinition Height="7*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Border CornerRadius="30" 
        Background="White" 
        ClipToBounds="False" 
        UseLayoutRounding="True"
                Margin="10,10,10,10" Grid.RowSpan="2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" 
                          ShadowDepth="0" 
                          Opacity="0.25" 
                          Color="Gray"/>
            </Border.Effect>

            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>
                <Image Source="/Resources/avatarka.png" Height="200" Width="200">
                    <Image.Clip>
                        <EllipseGeometry Center="100,100" RadiusX="100" RadiusY="100"/>
                    </Image.Clip>
                </Image>
                <TextBlock Grid.Row="2" Text="salchichon" FontSize="20" FontFamily="{StaticResource GothamProFamily}" HorizontalAlignment="Center"/>
                <Separator Grid.Row="3"/>
                <TextBlock Grid.Row="4" Text="ФИО" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                <TextBlock Grid.Row="6" Text="Фамилия Имя Отчество" FontSize="20" FontFamily="{StaticResource GothamProLight}" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="8" Text="Роль" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                <TextBlock Grid.Row="10" Text="Администратор" FontSize="20" FontFamily="{StaticResource GothamProLight}" FontWeight="Light" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="12" Text="Магазин" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                <TextBlock Grid.Row="14" Text="ул. Бэмбикс, Мамиксовый переулок" FontSize="20" FontFamily="{StaticResource GothamProLight}" FontWeight="Light" TextWrapping="Wrap"/>

                <Button Grid.Row="16" Content="Сменить пароль" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
            </Grid>
        </Border>

        <Grid Name="ClientProfileGrid" Grid.Column="2" Grid.RowSpan="2" Visibility="Hidden">
            <Border CornerRadius="30" 
                Background="White" 
                ClipToBounds="False" 
                UseLayoutRounding="True"
                Margin="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" 
                  ShadowDepth="0" 
                  Opacity="0.25" 
                  Color="Gray"/>
                </Border.Effect>

                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="История покупок" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                    <Grid Grid.Row="2" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Width="150" Height="50" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                            <Button Grid.Column="2" Padding="2" Height="50" Background="White" BorderBrush="White">
                                <Button.Content>
                                    <Image Source="/Resources/search.png"/>
                                </Button.Content>
                            </Button>
                        </Grid>

                        <GroupBox Grid.Column="2" Header="Сортировать по" Style="{x:Null}" BorderThickness="2" BorderBrush="Black" FontSize="20" FontFamily="{StaticResource GothamProFamily}">
                            <ComboBox Name="OrderByCmb">
                                <ComboBoxItem Content="Дате" Name="Date"/>
                                <ComboBoxItem Content="Цене" Name="Cost"/>
                                <ComboBoxItem Content="Нет" Name="Nothing"/>
                            </ComboBox>
                        </GroupBox>

                        <GroupBox Grid.Column="4" Header="Дата" Style="{x:Null}" BorderThickness="2" BorderBrush="Black" FontSize="20" FontFamily="{StaticResource GothamProFamily}">
                            <DatePicker Grid.Column="2" FontSize="20" Width="150" Language="Ru"/>
                        </GroupBox>
                    </Grid>
                    <ListBox Name="HistoryListBox" Grid.Row="4">
                        <!-- Отключаем выделение элементов -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <!-- Отключаем выделение и фокус -->
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <!-- Растягиваем содержимое по ширине -->
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>


                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="30" 
                    Background="White" 
                    ClipToBounds="False" 
                    UseLayoutRounding="True"
                    Margin="10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" 
                                      ShadowDepth="0" 
                                      Opacity="0.25" 
                                      Color="Gray"/>
                                    </Border.Effect>

                                    <Grid Margin="20">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <!-- Заголовки -->
                                            <RowDefinition Height="5"/>
                                            <!-- Отступ -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- Список товаров -->
                                            <RowDefinition Height="10"/>
                                            <!-- Отступ -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- Нижняя панель -->
                                        </Grid.RowDefinitions>

                                        <!-- Заголовки колонок -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <!-- Иконка + xN + название -->
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <!-- Цена за 1 -->
                                                <ColumnDefinition Width="Auto"/>
                                                <!-- Цена всего -->
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" 
                                   Text="Товар" 
                                   FontFamily="{StaticResource GothamProFamily}" 
                                   FontSize="14" 
                                   FontWeight="Bold"/>
                                            <TextBlock Grid.Column="2" 
                                   Text="Цена за 1" 
                                   FontFamily="{StaticResource GothamProFamily}" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Margin="0,0,20,0"/>
                                            <TextBlock Grid.Column="3" 
                                   Text="Цена всего" 
                                   FontFamily="{StaticResource GothamProFamily}" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Margin="20,0,0,0"/>
                                        </Grid>

                                        <!-- Список товаров -->
                                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <!-- Иконка -->
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <!-- xN -->
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <!-- Название (растягивается) -->
                                                            <ColumnDefinition Width="Auto"/>
                                                            <!-- Цена за 1 -->
                                                            <ColumnDefinition Width="Auto"/>
                                                            <!-- Цена всего -->
                                                        </Grid.ColumnDefinitions>

                                                        <Image Source="{Binding ImageSource}" 
                                           Width="40" Height="40" 
                                           Grid.Column="0"/>

                                                        <TextBlock Text="{Binding Quantity, StringFormat='x{}{0}'}" 
                                               Grid.Column="2" 
                                               FontFamily="{StaticResource GothamProLight}" 
                                               FontSize="16" 
                                               VerticalAlignment="Center"/>

                                                        <!-- Название товара с переносом -->
                                                        <TextBlock Text="{Binding Name}" 
                                               Grid.Column="4"
                                               FontFamily="{StaticResource GothamProLight}" 
                                               FontSize="16" 
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="5,0"/>

                                                        <TextBlock Grid.Column="5" 
                                               FontFamily="{StaticResource GothamProLight}" 
                                               FontSize="16" 
                                               VerticalAlignment="Center"
                                               Margin="0,0,20,0">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0:N2} ₽">
                                                                    <Binding Path="PricePerUnit"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>

                                                        <TextBlock Grid.Column="6" 
                                               FontFamily="{StaticResource GothamProLight}" 
                                               FontSize="16" 
                                               VerticalAlignment="Center"
                                               Margin="20,0,0,0">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0:N2} ₽">
                                                                    <Binding Path="TotalPrice"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>

                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Margin" Value="0,0,0,10"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                        </ItemsControl>

                                        <!-- Нижняя панель с кнопкой и итогами -->
                                        <Grid Grid.Row="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Content="Подробно" 
                                FontFamily="{StaticResource GothamProFamily}" 
                                FontSize="16" 
                                Padding="10,5" 
                                Command="{Binding ViewDetailsCommand}"/>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                                <TextBlock Text="Дата:" 
                                       FontFamily="{StaticResource GothamProFamily}" 
                                       FontSize="14" 
                                       FontWeight="Bold"
                                       Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding OrderDate, StringFormat='{}{0:dd.MM.yyyy}'}" 
                                       FontFamily="{StaticResource GothamProLight}" 
                                       FontSize="14"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Итого:" 
                                       FontFamily="{StaticResource GothamProFamily}" 
                                       FontSize="14" 
                                       FontWeight="Bold"
                                       Margin="0,0,5,0"/>
                                                <TextBlock FontFamily="{StaticResource GothamProLight}" FontSize="14">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0:N2} ₽">
                                                            <Binding Path="TotalOrderPrice"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="2" Name="EmployeeProfileGrid" Visibility="Visible" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="0" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <Border CornerRadius="30" 
                Background="White" 
                ClipToBounds="False" 
                UseLayoutRounding="True"
                Margin="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" 
                  ShadowDepth="0" 
                  Opacity="0.25" 
                  Color="Gray"/>
                </Border.Effect>

                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Расписание" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                    <Border Grid.Row="2" CornerRadius="30" BorderBrush="White" BorderThickness="1">
                        <Calendar Language="Ru" FontFamily="{StaticResource GothamProLight}"/>
                    </Border>
                </Grid>
            </Border>

            <Border CornerRadius="30" 
                Background="White" 
                ClipToBounds="False" 
                UseLayoutRounding="True"
                Margin="10" Grid.Row="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" 
                  ShadowDepth="0" 
                  Opacity="0.25" 
                  Color="Gray"/>
                </Border.Effect>

                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Задачи" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                    <ListBox Name="TasksListBox" Grid.Row="2">
    <!-- Отключаем выделение элементов -->
    <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ListBox.ItemContainerStyle>

    <!-- Горизонтальная упаковка с переносом -->
    <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" 
                       IsItemsHost="True"
                       Margin="0"/>
        </ItemsPanelTemplate>
    </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Карточка задачи -->
                                <Border CornerRadius="20" 
                Background="White" 
                Margin="10" 
                MinWidth="240"
                MaxWidth="320"
                BorderBrush="LightGray"
                BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.2" Color="Gray"/>
                                    </Border.Effect>
                                    <Grid Margin="15">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Чекбокс + название задачи (с переносом) -->
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding IsCompleted}" 
                              VerticalAlignment="Top"
                              Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Title}" 
                               FontFamily="{StaticResource GothamProFamily}" 
                               FontSize="18" 
                               TextWrapping="Wrap"
                               MaxWidth="250"/>
                                        </StackPanel>

                                        <!-- Начало -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                            <TextBlock Text="Начало: " 
                               FontFamily="{StaticResource GothamProFamily}"
                               FontSize="14"/>
                                            <TextBlock Text="{Binding StartDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" 
                               FontFamily="{StaticResource GothamProLight}"
                               FontSize="14"
                               TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Дедлайн -->
                                        <StackPanel Grid.Row="4" Orientation="Horizontal">
                                            <TextBlock Text="Дедлайн: " 
                               FontFamily="{StaticResource GothamProFamily}"
                               FontSize="14"/>
                                            <TextBlock Text="{Binding Deadline, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" 
                               FontFamily="{StaticResource GothamProLight}"
                               FontSize="14"
                               TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Автор (новая строка) -->
                                        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
                                            <TextBlock Text="Автор: " 
                               FontFamily="{StaticResource GothamProFamily}"
                               FontSize="14"/>
                                            <TextBlock Text="{Binding AuthorName}" 
                               FontFamily="{StaticResource GothamProLight}"
                               FontSize="14"
                               TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Статус выполнения -->
                                        <TextBlock Grid.Row="7" Margin="0,10,0,0"
                           FontFamily="{StaticResource GothamProLight}"
                           FontSize="12"
                           Foreground="Gray">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="✓ Выполнено"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="False">
                                                            <Setter Property="Text" Value="○ Не выполнено"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>


    </Grid>
</Page>

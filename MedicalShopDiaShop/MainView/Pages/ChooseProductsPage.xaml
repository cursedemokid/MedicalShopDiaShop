<Page x:Class="MedicalShopDiaShop.MainView.Pages.ChooseProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MedicalShopDiaShop.MainView.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Title="ChooseProductsPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя часть: доступные товары -->
        <Border Grid.Row="0" CornerRadius="20" Background="White" BorderBrush="LightGray" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Доступные товары" FontSize="18" FontWeight="Bold" 
                           FontFamily="{StaticResource GothamProFamily}" Margin="15,10"/>
                <ListBox x:Name="AvailableProductsListBox" Grid.Row="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionMode="Single">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Карточка доступного товара -->
                            <Border CornerRadius="20" Background="White" Margin="10" 
                                    BorderBrush="LightGray" BorderThickness="1"
                                    MouseLeftButtonDown="AvailableProduct_MouseLeftButtonDown" Cursor="Hand">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.2" Color="Gray"/>
                                </Border.Effect>
                                <Grid Margin="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Image}" Width="100" Height="100"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock FontSize="18" Text="{Binding Name}" 
                                                   FontFamily="{StaticResource GothamProFamily}" 
                                                   TextWrapping="Wrap" Margin="0,0,0,5"/>
                                        <TextBlock FontSize="14" Text="{Binding Description}" 
                                                   FontFamily="{StaticResource GothamProLight}" 
                                                   TextWrapping="Wrap" Foreground="Gray"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" FontSize="18" 
                                               Text="{Binding PricePerUnit, StringFormat='Цена/1: {0:N2} ₽'}" 
                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                               FontFamily="{StaticResource GothamProFamily}" Margin="10,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Нижняя часть: корзина -->
        <Border Grid.Row="2" CornerRadius="20" Background="White" BorderBrush="LightGray" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Корзина" FontSize="18" FontWeight="Bold" 
                           FontFamily="{StaticResource GothamProFamily}" Margin="15,10"/>

                <!-- Если корзина пуста, показываем картинку -->
                <Image x:Name="EmptyCartImage" Grid.Row="1" Source="/Resources/basket.png" 
                       Width="150" Height="150" Visibility="Visible"/>

                <ListBox x:Name="CartListBox" Grid.Row="1" Visibility="Collapsed"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Карточка товара в корзине -->
                            <Border CornerRadius="20" Background="White" Margin="10" 
                                    BorderBrush="LightGray" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.2" Color="Gray"/>
                                </Border.Effect>
                                <Grid Margin="10" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Product.Image}" Width="100" Height="100"/>
                                    <TextBlock Grid.Column="2" FontSize="18" Text="{Binding Product.Name}" 
                                               FontFamily="{StaticResource GothamProFamily}" 
                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                               ToolTip="{Binding Product.Description}"/>
                                    <TextBlock Grid.Column="3" FontSize="16" 
                                               Text="{Binding UnitPriceText}" 
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               FontFamily="{StaticResource GothamProFamily}" Margin="10,0"/>
                                    <TextBlock Grid.Column="5" FontSize="18" Text="{Binding Quantity}" 
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               FontFamily="{StaticResource GothamProFamily}"/>
                                    <Button Grid.Column="7" Padding="2" HorizontalAlignment="Center" 
                                            VerticalAlignment="Center" Click="DecreaseQuantity_Click" Tag="{Binding}"
                                            Height="50">
                                        <Image x:Name="MinusIcon" Source="/Resources/minus.png" Width="45" Height="45"/>
                                    </Button>
                                    <TextBlock Grid.Column="9" FontSize="16" 
                                               Text="{Binding TotalPriceText}" 
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               FontFamily="{StaticResource GothamProFamily}" Margin="10,0"/>
                                    <Button Grid.Column="11" Padding="2" HorizontalAlignment="Center" 
                                            VerticalAlignment="Center" Click="IncreaseQuantity_Click" Tag="{Binding}"
                                            Height="50">
                                        <Image Source="/Resources/more.png" Width="45" Height="45"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                    <TextBlock Text="Итого: " FontSize="16" FontWeight="Bold" 
                               FontFamily="{StaticResource GothamProFamily}"/>
                    <TextBlock x:Name="TotalPriceText" Text="0,00 ₽" FontSize="16" 
                               FontFamily="{StaticResource GothamProFamily}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Кнопка Продолжить -->
        <Button x:Name="ContinueButton" Grid.Row="3" Content="Продолжить" 
                Width="200" Height="40" Margin="20" HorizontalAlignment="Right"
                Style="{StaticResource MaterialDesignFlatButton}" Click="ContinueButton_Click"/>
    </Grid>
</Page>
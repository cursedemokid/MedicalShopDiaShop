<Page x:Class="MedicalShopDiaShop.MainView.Pages.ChooseProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MedicalShopDiaShop.MainView.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Title="ChooseProductsPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя часть: доступные товары -->
        <Border Grid.Row="0" CornerRadius="20" Background="White" BorderBrush="LightGray" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Доступные товары" FontSize="18" FontWeight="Bold" 
                           FontFamily="{StaticResource GothamProFamily}" Margin="15,10"/>
                <ListBox x:Name="AvailableProductsListBox" Grid.Row="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionMode="Single">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Карточка доступного товара -->
                            <Border CornerRadius="20" Background="White" Margin="10" 
                                    BorderBrush="LightGray" BorderThickness="1"
                                    MouseLeftButtonDown="AvailableProduct_MouseLeftButtonDown" Cursor="Hand">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.2" Color="Gray"/>
                                </Border.Effect>
                                <Grid Margin="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Image}" Width="100" Height="100"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock FontSize="18" Text="{Binding Name}" 
                                                   FontFamily="{StaticResource GothamProFamily}" 
                                                   TextWrapping="Wrap" Margin="0,0,0,5"/>
                                        <TextBlock FontSize="14" Text="{Binding Description}" 
                                                   FontFamily="{StaticResource GothamProLight}" 
                                                   TextWrapping="Wrap" Foreground="Gray"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0">
                                        <TextBlock FontSize="14" Text="{Binding RetailUnitLabel}"
                                                   FontFamily="{StaticResource GothamProLight}" Foreground="Gray"/>
                                        <TextBlock FontSize="16" Text="{Binding WholesaleUnitLabel}"
                                                   FontFamily="{StaticResource GothamProFamily}" Foreground="#2E7D32"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Нижняя часть: корзина -->
        <Border Grid.Row="2" CornerRadius="20" Background="White" BorderBrush="LightGray" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Корзина" FontSize="18" FontWeight="Bold" 
                           FontFamily="{StaticResource GothamProFamily}" Margin="15,10"/>

                <!-- Если корзина пуста, показываем картинку -->
                <Image x:Name="EmptyCartImage" Grid.Row="1" Source="/Resources/basket.png" 
                       Width="150" Height="150" Visibility="Visible"/>

                <ListBox x:Name="CartListBox" Grid.Row="1" Visibility="Collapsed"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Background="White" Margin="6,4" Padding="8"
                                    BorderBrush="LightGray" BorderThickness="1" HorizontalAlignment="Stretch">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.15" Color="Gray"/>
                                </Border.Effect>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" MinWidth="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Product.Image}" Width="64" Height="64"
                                           VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="15" Text="{Binding Product.Name}"
                                                   FontFamily="{StaticResource GothamProFamily}"
                                                   TextWrapping="Wrap" ToolTip="{Binding Product.Description}"/>
                                        <TextBlock FontSize="12" Text="{Binding UnitPriceText}"
                                                   FontFamily="{StaticResource GothamProLight}" Foreground="#444444"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <TextBlock FontSize="12" Text="{Binding TotalPriceText}"
                                                   FontFamily="{StaticResource GothamProFamily}" Foreground="#2E7D32"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Button Padding="4" Click="DecreaseQuantity_Click" Tag="{Binding}"
                                                Height="36" Width="36" VerticalAlignment="Center"
                                                ToolTip="Уменьшить / убрать из корзины">
                                            <Image Source="/Resources/minus.png" Width="22" Height="22"/>
                                        </Button>
                                        <TextBlock Text="{Binding Quantity}" MinWidth="28" TextAlignment="Center"
                                                   VerticalAlignment="Center" Margin="4,0"
                                                   FontSize="16" FontFamily="{StaticResource GothamProFamily}"/>
                                        <Button Padding="4" Click="IncreaseQuantity_Click" Tag="{Binding}"
                                                Height="36" Width="36" VerticalAlignment="Center"
                                                ToolTip="Добавить 1 шт.">
                                            <Image Source="/Resources/more.png" Width="22" Height="22"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="15,0,15,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="К оплате поставщику: " FontSize="16" FontWeight="Bold" 
                                   FontFamily="{StaticResource GothamProFamily}"/>
                        <TextBlock x:Name="TotalPriceText" Text="0,00 ₽" FontSize="16" FontWeight="Bold"
                                   FontFamily="{StaticResource GothamProFamily}"/>
                    </StackPanel>
                    <TextBlock x:Name="SavingsSummaryText" Text="" FontSize="13" Foreground="#555"
                               FontFamily="{StaticResource GothamProLight}" TextWrapping="Wrap"
                               HorizontalAlignment="Right" TextAlignment="Right" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Кнопка Продолжить -->
        <Button x:Name="ContinueButton" Grid.Row="3" Content="Продолжить" 
                Width="200" Height="40" Margin="20" HorizontalAlignment="Right"
                Style="{StaticResource MaterialDesignFlatButton}" Click="ContinueButton_Click"/>
    </Grid>
</Page>
<Page x:Class="MedicalShopDiaShop.MainView.Pages.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="694" d:DesignWidth="1033"
      Title="OrdersPage">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="10" />
            <RowDefinition Height="100" />
            <RowDefinition Height="10" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель: поиск + кнопки действий -->
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Width="400" Height="50" FontSize="20" FontFamily="{StaticResource GothamProFamily}" />
                <Button Grid.Column="2" Padding="2" Height="50" Background="White" BorderBrush="White" Click="SearchBtn_Click">
                    <Button.Content>
                        <Image Source="/Resources/search.png"/>
                    </Button.Content>
                </Button>
            </Grid>

            <Button Name="AddBtn" Grid.Column="3" Content="Добавить" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Click="AddBtn_Click" Height="50"/>
            <Button Name="EditBtn" Grid.Column="5" Content="Изменить" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Click="EditBtn_Click" Height="50"/>
            <Button Name="DeleteBtn" Grid.Column="7" Content="Удалить" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Click="DeleteBtn_Click" Height="50"/>
        </Grid>

        <!-- Панель фильтрации и переключения вида -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="1" Style="{x:Null}" BorderBrush="Black" BorderThickness="2">
                <GroupBox.Header>
                    <TextBlock Text="Статус" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                </GroupBox.Header>
                <ComboBox x:Name="StatusFilterComboBox" Width="200" FontSize="18"
              SelectionChanged="StatusFilterComboBox_SelectionChanged">
                    <ComboBoxItem Tag="1">В обработке</ComboBoxItem>
                    <ComboBoxItem Tag="2">Ожидает курьера</ComboBoxItem>
                    <ComboBoxItem Tag="3">Доставлен</ComboBoxItem>
                    <ComboBoxItem Tag="4">Ожидает оплаты</ComboBoxItem>
                    <ComboBoxItem Tag="5">В истории</ComboBoxItem>
                    <ComboBoxItem Tag="9">У курьера</ComboBoxItem>
                </ComboBox>
            </GroupBox>

            <Grid Grid.Column="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Button Name="ListBoxOnBtn" Grid.Column="2" Background="White" Padding="1" BorderThickness="0" Height="50" Click="ListBoxOnBtn_Click">
                    <Button.Content>
                        <Image Source="/Resources/dots.png" Width="70"/>
                    </Button.Content>
                </Button>
                <Button Name="ListViewOnBtn" Background="White" Padding="1" BorderThickness="0" Height="50" Click="ListViewOnBtn_Click">
                    <Button.Content>
                        <Image Source="/Resources/menu.png" Width="70"/>
                    </Button.Content>
                </Button>
            </Grid>
        </Grid>

        <!-- Область отображения заказов (ListView и ListBox) -->
        <Grid Grid.Row="4" Margin="10">
            <!-- ListView (табличный вид) -->
            <ListView Name="OrdersListView" 
                      Visibility="Visible" 
                      FontSize="20" 
                      FontFamily="{StaticResource GothamProFamily}"
                      AlternationCount="2"
                      SelectionMode="Single">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="№ заказа" DisplayMemberBinding="{Binding Id}" Width="auto"/>
                        <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding OrderDate, StringFormat='dd.MM.yyyy'}" Width="auto"/>
                        <GridViewColumn Header="Клиент" DisplayMemberBinding="{Binding ClientFullName}" Width="auto"/>
                        <GridViewColumn Header="Собирал" DisplayMemberBinding="{Binding WorkerFullName}" Width="auto"/>
                        <GridViewColumn Header="Доставлял" DisplayMemberBinding="{Binding CourierFullName}" Width="auto"/>
                        <GridViewColumn Header="Доставка" DisplayMemberBinding="{Binding DeliveryTypeName}" Width="auto"/>
                        <GridViewColumn Header="Статус" Width="auto">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedValue="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="Tag" IsSynchronizedWithCurrentItem="True" DisplayMemberPath="Content"
                      SelectionChanged="OrderStatus_SelectionChanged"
                      Tag="{Binding Id}" Width="140">
                                        <ComboBoxItem Content="В обработке" Tag="1"/>
                                        <ComboBoxItem Content="Ожидает курьера" Tag="2"/>
                                        <ComboBoxItem Content="Доставлен" Tag="3"/>
                                        <ComboBoxItem Content="Ожидает оплаты" Tag="4"/>
                                        <ComboBoxItem Content="В истории" Tag="5"/>
                                        <ComboBoxItem Content="У курьера" Tag="9"/>
                                    </ComboBox>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Сумма" DisplayMemberBinding="{Binding TotalCost, StringFormat='{}{0:N2} ₽'}" Width="auto"/>
                        <GridViewColumn Width="auto">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Подробнее" 
                                            FontSize="16" 
                                            FontFamily="{StaticResource GothamProFamily}"
                                            Click="Details_Click" 
                                            Tag="{Binding}"
                                            Margin="5,2"
                                            Width="150"
                                            HorizontalContentAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- ListBox (плитки с товарами) -->
            <ListBox Name="OrdersListBox" 
                     Visibility="Collapsed" 
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" IsItemsHost="True" Margin="0"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Карточка заказа -->
                        <Border CornerRadius="30" 
                                Background="White" 
                                Margin="10" 
                                Width="500"
                                BorderBrush="LightGray"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.25" Color="Gray"/>
                            </Border.Effect>
                            <Grid Margin="20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Верхняя строка: чекбокс и номер заказа -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Id, StringFormat='Заказ №{0}'}" 
                                               FontSize="20" FontFamily="{StaticResource GothamProFamily}" FontWeight="Bold"
                                               HorizontalAlignment="Right"/>
                                </Grid>

                                <Separator Grid.Row="1"/>

                                <!-- Основная информация -->
                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="Дата:" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                                    <TextBlock Text="{Binding OrderDate, StringFormat='dd.MM.yyyy HH:mm'}" FontSize="20" FontFamily="{StaticResource GothamProLight}"/>
                                    <TextBlock Text="Клиент:" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Margin="0,10,0,0"/>
                                    <TextBlock Text="{Binding ClientFullName}" FontSize="20" FontFamily="{StaticResource GothamProLight}"/>
                                    <TextBlock Text="Собирал:" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Margin="0,10,0,0"/>
                                    <TextBlock Text="{Binding WorkerFullName}" FontSize="20" FontFamily="{StaticResource GothamProLight}"/>
                                    <TextBlock Text="Курьер:" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Margin="0,10,0,0"/>
                                    <TextBlock Text="{Binding CourierFullName}" FontSize="20" FontFamily="{StaticResource GothamProLight}"/>
                                    <TextBlock Text="Тип доставки:" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Margin="0,10,0,0"/>
                                    <TextBlock Text="{Binding DeliveryTypeName}" FontSize="20" FontFamily="{StaticResource GothamProLight}"/>
                                    <TextBlock Text="Статус:" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Margin="0,10,0,0"/>
                                    <TextBlock Text="{Binding StatusName}" FontSize="20" FontFamily="{StaticResource GothamProLight}"/>
                                </StackPanel>

                                <!-- Данные доставки (если есть) -->
                                <StackPanel Grid.Row="4">
                                    <TextBlock Text="Доставка:" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Margin="0,10,0,0"/>
                                    <TextBlock Text="{Binding DeliveryDescription}" FontSize="20" FontFamily="{StaticResource GothamProLight}"/>
                                    <TextBlock Text="{Binding DeliveryStartDate, StringFormat='Начало: dd.MM.yyyy'}" FontSize="20" FontFamily="{StaticResource GothamProLight}"/>
                                    <TextBlock Text="{Binding DeliveryEndDate, StringFormat='Окончание: dd.MM.yyyy'}" FontSize="20" FontFamily="{StaticResource GothamProLight}"/>
                                </StackPanel>

                                <!-- Список товаров -->
                                <TextBlock Grid.Row="6" Text="Товары:" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Margin="0,10,0,5"/>
                                <ItemsControl Grid.Row="7" ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding ImagePath}" Width="50" Height="50" Grid.Column="0"/>
                                                <TextBlock Text="{Binding Quantity, StringFormat='x{}{0}'}" 
                                                           Grid.Column="2" FontSize="18" FontFamily="{StaticResource GothamProLight}"/>
                                                <TextBlock Text="{Binding ProductName}" Grid.Column="4" FontSize="18" 
                                                           FontFamily="{StaticResource GothamProLight}" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="5" FontSize="18" FontFamily="{StaticResource GothamProLight}" Margin="10,0,0,0">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0:N2} ₽">
                                                            <Binding Path="PricePerUnit"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Grid.Column="6" FontSize="18" FontFamily="{StaticResource GothamProLight}" Margin="20,0,0,0">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0:N2} ₽">
                                                            <Binding Path="TotalPrice"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Итого и кнопка -->
                                <Grid Grid.Row="9" Margin="0,15,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Итого:" FontSize="20" FontFamily="{StaticResource GothamProFamily}" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TotalCost, StringFormat='{}{0:N2} ₽'}" 
                                               FontSize="20" FontFamily="{StaticResource GothamProFamily}" FontWeight="Bold"/>
                                </Grid>
                                <Button Grid.Row="9" Content="Подробнее" FontSize="18" FontFamily="{StaticResource GothamProFamily}"
                                        Click="Details_Click" Tag="{Binding}" HorizontalAlignment="Center" Margin="0,40,0,0" Width="150"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Page>
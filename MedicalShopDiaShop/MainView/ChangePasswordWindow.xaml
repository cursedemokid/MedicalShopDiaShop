<Window x:Class="MedicalShopDiaShop.MainView.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Смена пароля" Height="720" Width="1280" MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid>
        <Image Source="/Resources/BackgroundPatternPurple.png" Stretch="Fill"/>

        <Border CornerRadius="20" BorderThickness="1" BorderBrush="White" Background="White"
                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
            <Grid Width="500">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Смена пароля" 
                           FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" 
                           FontFamily="{StaticResource GothamProFamily}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Старый пароль" 
                           VerticalAlignment="Center" HorizontalAlignment="Right" 
                           FontSize="18" FontFamily="{StaticResource GothamProFamily}"/>
                <Border Grid.Row="2" Grid.Column="2" BorderThickness="1" BorderBrush="Black" CornerRadius="3">
                    <PasswordBox x:Name="OldPasswordBox" FontSize="18" FontFamily="{StaticResource GothamProFamily}" Height="35"/>
                </Border>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Новый пароль" 
                           VerticalAlignment="Center" HorizontalAlignment="Right" 
                           FontSize="18" FontFamily="{StaticResource GothamProFamily}"/>
                <Border Grid.Row="4" Grid.Column="2" BorderThickness="1" BorderBrush="Black" CornerRadius="3">
                    <PasswordBox x:Name="NewPasswordBox" FontSize="18" FontFamily="{StaticResource GothamProFamily}" Height="35"/>
                </Border>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Подтверждение" 
                           VerticalAlignment="Center" HorizontalAlignment="Right" 
                           FontSize="18" FontFamily="{StaticResource GothamProFamily}"/>
                <Border Grid.Row="6" Grid.Column="2" BorderThickness="1" BorderBrush="Black" CornerRadius="3">
                    <PasswordBox x:Name="ConfirmPasswordBox" FontSize="18" FontFamily="{StaticResource GothamProFamily}" Height="35"/>
                </Border>

                <Grid Grid.Row="8" Grid.ColumnSpan="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" x:Name="SaveBtn" Content="Сохранить" Height="35" Width="120"
                            Click="SaveBtn_Click" Margin="10" FontSize="18" FontFamily="{StaticResource GothamProFamily}"/>
                    <Button Grid.Column="3" x:Name="CancelBtn" Content="Отмена" Height="35" Width="120"
                            Click="CancelBtn_Click" Margin="10" FontSize="18" FontFamily="{StaticResource GothamProFamily}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
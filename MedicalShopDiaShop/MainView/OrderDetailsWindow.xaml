<Window x:Class="MedicalShopDiaShop.MainView.OrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детали заказа" Height="720" Width="900"
        WindowStartupLocation="CenterOwner" MinHeight="500" MinWidth="700">
    <Grid>
        <Image Source="/Resources/BackgroundPatternPurple.png" Stretch="Fill"/>

        <Border CornerRadius="20" BorderThickness="1" BorderBrush="White" Background="White"
                Margin="20" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <TextBlock x:Name="TitleText" Text="Заказ №0" FontSize="24" FontWeight="Bold"
                               FontFamily="{StaticResource GothamProFamily}" HorizontalAlignment="Center"/>

                    <!-- Информация о заказе -->
                    <Border Grid.Row="2" CornerRadius="15" Background="#F5F5F5" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Дата:" FontWeight="Bold" FontSize="16" FontFamily="{StaticResource GothamProFamily}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="DateText" FontSize="16" FontFamily="{StaticResource GothamProLight}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Клиент:" FontWeight="Bold" FontSize="16" FontFamily="{StaticResource GothamProFamily}"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="ClientText" FontSize="16" FontFamily="{StaticResource GothamProLight}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Собирал:" FontWeight="Bold" FontSize="16" FontFamily="{StaticResource GothamProFamily}"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" x:Name="WorkerText" FontSize="16" FontFamily="{StaticResource GothamProLight}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Курьер:" FontWeight="Bold" FontSize="16" FontFamily="{StaticResource GothamProFamily}"/>
                            <TextBlock Grid.Row="6" Grid.Column="2" x:Name="CourierText" FontSize="16" FontFamily="{StaticResource GothamProLight}"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Статус:" FontWeight="Bold" FontSize="16" FontFamily="{StaticResource GothamProFamily}"/>
                            <TextBlock Grid.Row="8" Grid.Column="2" x:Name="StatusText" FontSize="16" FontFamily="{StaticResource GothamProLight}"/>

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Сумма:" FontWeight="Bold" FontSize="16" FontFamily="{StaticResource GothamProFamily}"/>
                            <TextBlock Grid.Row="10" Grid.Column="2" x:Name="TotalText" FontSize="16" FontFamily="{StaticResource GothamProLight}" Foreground="#4CAF50"/>
                        </Grid>
                    </Border>

                    <!-- Товары -->
                    <Border Grid.Row="4" CornerRadius="15" Background="#F5F5F5" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Товары" FontSize="18" FontWeight="Bold" FontFamily="{StaticResource GothamProFamily}"/>

                            <ItemsControl Grid.Row="2" x:Name="ProductsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Background="White" Margin="0,5" Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding Image}" Width="50" Height="50"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="16" FontFamily="{StaticResource GothamProFamily}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Quantity, StringFormat='x{0}'}" FontSize="16" FontFamily="{StaticResource GothamProLight}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" VerticalAlignment="Center">
                                                    <Run Text="{Binding TotalPrice, StringFormat={}{0:N2}}" FontSize="16" FontFamily="{StaticResource GothamProLight}"/>
                                                    <Run Text=" ₽" FontSize="16" FontFamily="{StaticResource GothamProLight}"/>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- История статусов -->
                    <Border Grid.Row="6" CornerRadius="15" Background="#F5F5F5" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="История изменений" FontSize="18" FontWeight="Bold" FontFamily="{StaticResource GothamProFamily}"/>

                            <ListBox x:Name="HistoryListBox" Grid.Row="2" MaxHeight="300" BorderThickness="0" Background="Transparent">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="5"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Background="White" Margin="0,5" Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding UpdateTime, StringFormat='dd.MM.yyyy HH:mm'}" FontSize="14" FontFamily="{StaticResource GothamProLight}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding OldStatusName}" FontSize="14" FontFamily="{StaticResource GothamProFamily}"/>
                                                <TextBlock Grid.Column="4" Text="→" FontSize="14" FontFamily="{StaticResource GothamProFamily}"/>
                                                <TextBlock Grid.Column="5" Text="{Binding NewStatusName}" FontSize="14" FontFamily="{StaticResource GothamProFamily}" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="6" Text="{Binding UserTransferText}" FontSize="12" FontFamily="{StaticResource GothamProLight}" Foreground="Gray" Margin="10,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
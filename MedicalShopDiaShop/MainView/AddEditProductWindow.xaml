<Window x:Class="MedicalShopDiaShop.MainView.AddEditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MedicalShopDiaShop.MainView"
        mc:Ignorable="d"
        Title="Добавление товара" Height="720" Width="1280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid>
        <Image Source="/Resources/BackgroundPatternPurple.png" Stretch="Fill"/>

        <Border CornerRadius="20" BorderThickness="1" BorderBrush="White" Background="White"
                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
            <Grid Width="500">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Заголовок -->
                <TextBlock Grid.ColumnSpan="3" x:Name="TitleText" Text="Добавление товара"
                           FontSize="24" FontWeight="Bold" FontFamily="{StaticResource GothamProFamily}"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <!-- Название -->
                <TextBlock Grid.Row="2" Text="Название" FontSize="18" FontFamily="{StaticResource GothamProFamily}"
                           VerticalAlignment="Center"/>
                <Border Grid.Row="2" Grid.Column="2" BorderThickness="1" BorderBrush="Black" CornerRadius="5">
                    <TextBox x:Name="NameTb" FontSize="18" FontFamily="{StaticResource GothamProFamily}" Padding="5"/>
                </Border>

                <!-- Описание -->
                <TextBlock Grid.Row="4" Text="Описание" FontSize="18" FontFamily="{StaticResource GothamProFamily}"
                           VerticalAlignment="Top"/>
                <Border Grid.Row="4" Grid.Column="2" BorderThickness="1" BorderBrush="Black" CornerRadius="5">
                    <TextBox x:Name="DescriptionTb" FontSize="18" FontFamily="{StaticResource GothamProFamily}"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="100" VerticalScrollBarVisibility="Auto"/>
                </Border>

                <!-- Категория -->
                <TextBlock Grid.Row="6" Text="Категория" FontSize="18" FontFamily="{StaticResource GothamProFamily}"
                           VerticalAlignment="Center"/>
                <Border Grid.Row="6" Grid.Column="2" BorderThickness="1" BorderBrush="Black" CornerRadius="5">
                    <ComboBox x:Name="CategoryCmb" FontSize="18" FontFamily="{StaticResource GothamProFamily}"/>
                </Border>

                <!-- Цена -->
                <TextBlock Grid.Row="8" Text="Цена (₽)" FontSize="18" FontFamily="{StaticResource GothamProFamily}"
                           VerticalAlignment="Center"/>
                <Border Grid.Row="8" Grid.Column="2" BorderThickness="1" BorderBrush="Black" CornerRadius="5">
                    <TextBox x:Name="PriceTb" FontSize="18" FontFamily="{StaticResource GothamProFamily}" Padding="5"/>
                </Border>

                <!-- Изображение -->
                <TextBlock Grid.Row="10" Text="Изображение" FontSize="18" FontFamily="{StaticResource GothamProFamily}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Row="10" Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="SelectImageBtn" Content="Выбрать файл" Margin="0,0,10,0"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Click="SelectImageBtn_Click"/>
                    <Image x:Name="PreviewImage" Width="80" Height="80" Stretch="Uniform"
                           Source="/Resources/productPlaceholder.png"/>
                </StackPanel>

                <!-- Кнопки -->
                <StackPanel Grid.Row="14" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button x:Name="SaveBtn" Content="Сохранить" Width="100" Margin="0,0,10,0"
                            Style="{StaticResource MaterialDesignFlatButton}" Click="SaveBtn_Click"/>
                    <Button x:Name="CancelBtn" Content="Отмена" Width="100"
                            Style="{StaticResource MaterialDesignFlatButton}" Click="CancelBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
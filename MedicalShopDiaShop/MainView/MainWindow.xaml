<Window x:Class="MedicalShopDiaShop.MainView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MedicalShopDiaShop.MainView"
        mc:Ignorable="d"
        Title="" Height="720" Width="1280" WindowStartupLocation="CenterScreen">
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>
        
        <Grid Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="80" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Диа" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="Green" FontSize="30" FontFamily="{StaticResource GothamProFamily}" />
                    <TextBlock Text="Шоп" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="Black" FontSize="30" FontFamily="{StaticResource GothamProFamily}" />
                </StackPanel>

                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Width="400" IsEditable="True" Height="50" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                    <Button Grid.Column="2" Padding="2" Height="50" Background="White" BorderBrush="White">
                        <Button.Content>
                            <Image Source="/Resources/search.png"/>
                        </Button.Content>
                    </Button>
                </Grid>
                
                <Button Name="NotificationsBtn" Grid.Column="4" VerticalContentAlignment="Center" Height="50" Padding="0" Background="White" BorderBrush="White" Click="NotificationsBtn_Click">
                    <Button.Content>
                        <Grid>
                            <Grid HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Ellipse Name="NotificationCheck" Fill="Red" Height="10" Width="10"/>
                            </Grid>
                            <Image Source="/Resources/notification.png"  Height="50"/>
                        </Grid>
                    </Button.Content>
                </Button>

                <Grid Grid.Column="6" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Image Source="/Resources/ProfileIcon.png" Height="50" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Профиль" FontFamily="{StaticResource GothamProFamily}" VerticalAlignment="Center" FontSize="20"/>
            </Grid>
        </Grid>
        
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" Name="MenuGrid"/>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>
                    <Button Name="ProfileVisualBtn" Grid.Row="1" Height="60" Click="ProfileBtn_Click" Visibility="Hidden">
                    </Button>
                    <Button Name="ProductsVisualBtn" Grid.Row="3" Height="60" Click="ProductsBtn_Click" Visibility="Hidden">
                    </Button>
                    <Button Name="StatsVisualBtn" Grid.Row="5" Height="60" Click="StatsBtn_Click" Visibility="Hidden">
                    </Button>
                    <Button Name="ClientsVisualBtn" Grid.Row="7" Height="60"  Click="ClientsBtn_Click" Visibility="Hidden">
                    </Button>
                    <Button Name="SuppliesVisualBtn" Grid.Row="9" Height="60"  Click="SuppliesBtn_Click" Visibility="Hidden">
                    </Button>
                    <Button Name="ExitVisualBtn" Grid.Row="15" Height="60" Click="ExitBtn_Click" Visibility="Hidden">
                    </Button>
                    <Button Name="EmployeesVisualBtn" Grid.Row="13" Height="60" Click="EmployeesBtn_Click" Visibility="Hidden">
                    </Button>
                    <Button Name="OrdersVisualBtn" Grid.Row="11" Height="60" Click="OrdersBtn_Click" Visibility="Hidden">
                    </Button>
                </Grid>
            
                <Grid Name="MaximizedButtons" Visibility="Visible" Margin="10 0 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>
                    <Button Name="MaxProfileBtn" Grid.Row="1" Height="60" Background="White" HorizontalContentAlignment="Left" Click="ProfileBtn_Click">
                        <Button.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="/Resources/ProfileIcon.png" Height="50"/>
                                <TextBlock Text="Профиль" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                    <Button Name="MaxProductsBtn" Grid.Row="3" Height="60" Background="White" HorizontalContentAlignment="Left" Click="ProductsBtn_Click">
                        <Button.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="/Resources/box.png" />
                                <TextBlock Text="Товары" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                    <Button Name="MaxStatsBtn" Grid.Row="5" Height="60" Background="White" HorizontalContentAlignment="Left" Click="StatsBtn_Click">
                        <Button.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="/Resources/chart.png" />
                                <TextBlock Text="Статистика" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                    <Button Name="MaxClientsBtn" Grid.Row="7" Height="60" Background="White" HorizontalContentAlignment="Left" Click="ClientsBtn_Click">
                        <Button.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="/Resources/customer.png" />
                                <TextBlock Text="Клиенты" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                    <Button Name="MaxSuppliesBtn" Grid.Row="9" Height="60" Background="White" HorizontalContentAlignment="Left" Click="SuppliesBtn_Click">
                        <Button.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="/Resources/delivery.png" />
                                <TextBlock Text="Поставщики" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                    <Button Name="MaxExitBtn" Grid.Row="15" Height="60" Background="White" HorizontalContentAlignment="Left" Click="ExitBtn_Click">
                        <Button.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="/Resources/logout.png" />

                                <TextBlock Text="Выход" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                    <Button Name="MaxEmployeesBtn" Grid.Row="13" Height="60" Background="White" HorizontalContentAlignment="Left" Click="EmployeesBtn_Click">
                        <Button.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="/Resources/teamwork.png" />
                                <TextBlock Text="Сотруднки" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                    <Button Name="MaxOrdersBtn" Grid.Row="11" Height="60" Background="White" HorizontalContentAlignment="Left" Click="OrdersBtn_Click">
                        <Button.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="/Resources/check_1742953.png" />
                                <TextBlock Text="Заказы" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                </Grid>
            
                <Grid Name="MinimizedButtons" Visibility="Collapsed" Margin="10 0 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>
                    <Button Name="ProfileBtn" Grid.Row="1" Height="60" Background="White" Click="ProfileBtn_Click">
                        <Button.Content>
                            <StackPanel>
                                <Image Source="/Resources/ProfileIcon.png" Height="30"/>
                                <TextBlock Text="Профиль" FontFamily="{StaticResource GothamProFamily}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button Name="ProductsBtn" Grid.Row="3" Height="60" Background="White" Click="ProductsBtn_Click">
                        <Button.Content>
                            <StackPanel>
                                <Image Source="/Resources/box.png" Height="30"/>
                                <TextBlock Text="Товары" FontFamily="{StaticResource GothamProFamily}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button Name="StatsBtn" Grid.Row="5" Height="60" Background="White" Click="StatsBtn_Click">
                        <Button.Content>
                            <StackPanel>
                                <Image Source="/Resources/chart.png" Height="30"/>
                                <TextBlock Text="Статистика" FontFamily="{StaticResource GothamProFamily}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button Name="ClientsBtn" Grid.Row="7" Height="60" Background="White" Click="ClientsBtn_Click">
                        <Button.Content>
                            <StackPanel>
                                <Image Source="/Resources/customer.png" Height="30"/>
                                <TextBlock Text="Клиенты" FontFamily="{StaticResource GothamProFamily}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button Name="SuppliesBtn" Grid.Row="9" Height="60" Background="White" Click="SuppliesBtn_Click">
                        <Button.Content>
                            <StackPanel>
                                <Image Source="/Resources/delivery.png" Height="30"/>
                                <TextBlock Text="Поставщики" FontFamily="{StaticResource GothamProFamily}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button Name="ExitBtn" Grid.Row="15" Height="60" Background="White" Click="ExitBtn_Click">
                        <Button.Content>
                            <StackPanel>
                                <Image Source="/Resources/logout.png" Height="30"/>
                                <TextBlock Text="Выход" FontFamily="{StaticResource GothamProFamily}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button Name="EmployeesBtn" Grid.Row="13" Height="60" Background="White" Click="EmployeesBtn_Click">
                        <Button.Content>
                            <StackPanel>
                                <Image Source="/Resources/teamwork.png" Height="30"/>
                                <TextBlock Text="Сотрудники" FontFamily="{StaticResource GothamProFamily}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button Name="OrdersBtn" Grid.Row="11" Height="60" Background="White" Click="OrdersBtn_Click">
                        <Button.Content>
                            <StackPanel>
                                <Image Source="/Resources/check_1742953.png" Height="30"/>
                                <TextBlock Text="Заказы" FontFamily="{StaticResource GothamProFamily}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>
            
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="7*" />
                    </Grid.RowDefinitions>
                    <Separator Height="Auto" Background="Green">
                        <Separator.LayoutTransform>
                            <RotateTransform Angle="90"/>
                        </Separator.LayoutTransform>
                    </Separator>
                    <Separator Grid.Row="2" Height="Auto" Background="Green">
                        <Separator.LayoutTransform>
                            <RotateTransform Angle="90"/>
                        </Separator.LayoutTransform>
                    </Separator>
                    <Button Name="MinimizeOrMaximizeBtn" Grid.Row="1" Background="White" Width="20" Height="20" Padding="2" Click="MinimizeOrMaximizeBtn_Click">
                        <Button.Content>
                            <Image Source="/Resources/left-arrow.png" Name="ArrowIcon"/>
                        </Button.Content>
                    </Button>

                </Grid>
                <Frame Grid.Column="4" Name="MainFrame" NavigationUIVisibility="Hidden"/>
            </Grid>

        </Grid>
        <Grid Name="BlurGrid" Background="White" Opacity="0.4" Visibility="Collapsed" MouseDown="BlurGrid_MouseDown"/>
        <Grid Name="NotificationGrid" Visibility="Collapsed" HorizontalAlignment="Right" Grid.Column="1" Background="White">
        
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="10" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Grid Width="300">
                <TextBlock Text="Уведомления" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Margin="10 0 0 0"/>
            </Grid>
            <ListBox Name="NotificationListBox" Grid.Row="2">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="300" Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Ellipse HorizontalAlignment="Right" VerticalAlignment="Top" Fill="Blue" Height="10" Width="10" Visibility="{Binding Visibility}"/>
                            <TextBlock Grid.Row="0" Text="Заголовок" FontFamily="{StaticResource GothamProFamily}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="2" Text="10 минут назад" FontFamily="{StaticResource GothamProFamily}" FontSize="15" FontWeight="Light" TextWrapping="Wrap"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Button Name="PreviousNotificationPageBtn" Grid.Column="1" Click="PreviousNotificationPageBtn_Click">
                    <Button.Content>
                        <Image Source="/Resources/left-arrow.png" />
                    </Button.Content>
                </Button>
                <TextBox Grid.Column="3" Width="70" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Text="11" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                <Button Name="NextNotificationPageBtn" Grid.Column="5" Click="NextNotificationPageBtn_Click">
                    <Button.Content>
                        <Image Source="/Resources/left-arrow.png" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <ScaleTransform ScaleX="-1" />
                            </Image.RenderTransform>
                        </Image>
                    </Button.Content>
                </Button>
            </Grid>
        </Grid>
    </Grid>

</Window>

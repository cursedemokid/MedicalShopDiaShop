<Window x:Class="MedicalShopDiaShop.MainView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MedicalShopDiaShop.MainView" xmlns:local1="clr-namespace:MedicalShopDiaShop.AppData"
        mc:Ignorable="d"
        Title="" MinHeight="720" MinWidth="1280" WindowStartupLocation="CenterScreen"
        Icon="/Resources/sugar.png">

    <Window.Resources>
        <!-- Анимация разворачивания меню -->
        <Storyboard x:Key="ExpandMenuAnimation">
            <DoubleAnimation Storyboard.TargetName="MaximizedButtons" 
                             Storyboard.TargetProperty="Width"
                             From="60" To="250" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MaximizedButtons" 
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.15"/>
        </Storyboard>

        <!-- Анимация сворачивания меню -->
        <Storyboard x:Key="CollapseMenuAnimation">
            <DoubleAnimation Storyboard.TargetName="MaximizedButtons" 
                             Storyboard.TargetProperty="Width"
                             From="250" To="60" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MaximizedButtons" 
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.15"/>
        </Storyboard>

        <!-- Анимация появления уведомлений (выезд справа) -->
        <Storyboard x:Key="ShowNotificationAnimation">
            <DoubleAnimation Storyboard.TargetName="NotificationGrid" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="300" To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="NotificationGrid" 
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.2"/>
        </Storyboard>

        <!-- Анимация скрытия уведомлений -->
        <Storyboard x:Key="HideNotificationAnimation">
            <DoubleAnimation Storyboard.TargetName="NotificationGrid" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="0" To="300" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="NotificationGrid" 
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.2"/>
        </Storyboard>

        <local1:RelativeDateConverter x:Key="RelativeDateConverter"/>
        
    </Window.Resources>

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="80" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Диа" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#FF673AB7" FontSize="30" FontFamily="{StaticResource GothamProFamily}" />
                    <TextBlock Text="Шоп" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="Black" FontSize="30" FontFamily="{StaticResource GothamProFamily}" />
                </StackPanel>

                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <!--<ComboBox Width="400" IsEditable="True" Height="50" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                    <Button Grid.Column="2" Padding="2" Height="50" Background="White" BorderBrush="White">
                        <Button.Content>
                            <Image Source="/Resources/search.png"/>
                        </Button.Content>
                    </Button>-->
                </Grid>

                <Button Name="NotificationsBtn" Grid.Column="4" VerticalContentAlignment="Center" Height="50" Padding="0" Background="White" BorderBrush="White" Click="NotificationsBtn_Click">
                    <Button.Content>
                        <Grid>
                            <Grid HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Ellipse Name="NotificationCheck" Fill="Red" Height="10" Width="10"/>
                            </Grid>
                            <Image Source="/Resources/notification.png" Height="50"/>
                        </Grid>
                    </Button.Content>
                </Button>

                <Grid Grid.Column="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <Image Name="UserAvatarImg" Source="/Resources/ProfileIcon.png" Height="50" VerticalAlignment="Center" >
                        <Image.Clip>
                            <EllipseGeometry Center="25,25" RadiusX="25" RadiusY="25"/>
                        </Image.Clip>
                    </Image>
                    <TextBlock Name="FullNameTbl" Foreground="Black" Grid.Column="2" Text="Профиль" FontFamily="{StaticResource GothamProFamily}" VerticalAlignment="Center" FontSize="20"/>
                </Grid>
            </Grid>

            <!-- Основная область -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Скрытые визуальные кнопки для подсветки (занимают место) -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>
                    <Button Name="ProfileVisualBtn" Grid.Row="1" Height="60" Click="ProfileBtn_Click" Visibility="Hidden" />
                    <Button Name="ProductsVisualBtn" Grid.Row="3" Height="60" Click="ProductsBtn_Click" Visibility="Hidden" />
                    <Button Name="StatsVisualBtn" Grid.Row="5" Height="60" Click="StatsBtn_Click" Visibility="Hidden" />
                    <Button Name="ClientsVisualBtn" Grid.Row="7" Height="60" Click="ClientsBtn_Click" Visibility="Hidden" />
                    <Button Name="SuppliesVisualBtn" Grid.Row="9" Height="60" Click="SuppliesBtn_Click" Visibility="Hidden" />
                    <Button Name="OrdersVisualBtn" Grid.Row="11" Height="60" Click="OrdersBtn_Click" Visibility="Hidden" />
                    <Button Name="EmployeesVisualBtn" Grid.Row="13" Height="60" Click="EmployeesBtn_Click" Visibility="Hidden" />
                    <Button Name="ExitVisualBtn" Grid.Row="15" Height="60" Click="ExitBtn_Click" Visibility="Hidden" />
                </Grid>

                <!-- Максимизированное меню (с текстом) -->
                <Grid Name="MaximizedButtons" Margin="10 0 0 0" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>
                    <!-- Кнопки (оставлены как у вас, но добавлен x:Name) -->
                    <Button x:Name="MaxProfileBtn" Grid.Row="1" Height="60" Background="White" HorizontalContentAlignment="Left" Click="ProfileBtn_Click" BorderThickness="0">
                        <Button.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="/Resources/ProfileIcon.png" Height="50"/>
                                <TextBlock Text="Профиль" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Foreground="Black"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                    <Button x:Name="MaxProductsBtn" Grid.Row="3" Height="60" Background="White" HorizontalContentAlignment="Left" Click="ProductsBtn_Click" BorderThickness="0">
                        <Button.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="/Resources/box.png" Height="50"/>
                                <TextBlock Text="Товары" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Foreground="Black"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                    <Button x:Name="MaxStatsBtn" Grid.Row="5" Height="60" Background="White" HorizontalContentAlignment="Left" Click="StatsBtn_Click" BorderThickness="0">
                        <Button.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="/Resources/chart.png" Height="50"/>
                                <TextBlock Text="Статистика" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Foreground="Black"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                    <Button x:Name="MaxClientsBtn" Grid.Row="7" Height="60" Background="White" HorizontalContentAlignment="Left" Click="ClientsBtn_Click" BorderThickness="0">
                        <Button.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="/Resources/customer.png" Height="50"/>
                                <TextBlock Text="Клиенты" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Foreground="Black"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                    <Button x:Name="MaxSuppliesBtn" Grid.Row="9" Height="60" Background="White" HorizontalContentAlignment="Left" Click="SuppliesBtn_Click" BorderThickness="0">
                        <Button.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="/Resources/delivery.png" Height="50"/>
                                <TextBlock Text="Поставщики" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Foreground="Black"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                    <Button x:Name="MaxOrdersBtn" Grid.Row="11" Height="60" Background="White" HorizontalContentAlignment="Left" Click="OrdersBtn_Click" BorderThickness="0">
                        <Button.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="/Resources/check_1742953.png" Height="50"/>
                                <TextBlock Text="Заказы" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Foreground="Black"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                    <Button x:Name="MaxEmployeesBtn" Grid.Row="13" Height="60" Background="White" HorizontalContentAlignment="Left" Click="EmployeesBtn_Click" BorderThickness="0">
                        <Button.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="/Resources/teamwork.png" Height="50"/>
                                <TextBlock Text="Сотрудники" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Foreground="Black"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                    <Button x:Name="MaxExitBtn" Grid.Row="15" Height="60" Background="White" HorizontalContentAlignment="Left" Click="ExitBtn_Click" BorderThickness="0">
                        <Button.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="/Resources/logout.png" Height="50"/>
                                <TextBlock Text="Выход" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Foreground="Black"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                </Grid>

                <!-- Свёрнутое меню (только иконки) -->
                <Grid Name="MinimizedButtons" Width="60" Margin="10 0 0 0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>
                    <Button x:Name="ProfileBtn" Grid.Row="1" Height="60" Background="White" Click="ProfileBtn_Click" BorderThickness="0" ToolTip="Профиль">
                        <Image Source="/Resources/ProfileIcon.png" Height="30"/>
                    </Button>
                    <Button x:Name="ProductsBtn" Grid.Row="3" Height="60" Background="White" Click="ProductsBtn_Click" BorderThickness="0" ToolTip="Товары">
                        <Image Source="/Resources/box.png" Height="30"/>
                    </Button>
                    <Button x:Name="StatsBtn" Grid.Row="5" Height="60" Background="White" Click="StatsBtn_Click" BorderThickness="0" ToolTip="Статистика">
                        <Image Source="/Resources/chart.png" Height="30"/>
                    </Button>
                    <Button x:Name="ClientsBtn" Grid.Row="7" Height="60" Background="White" Click="ClientsBtn_Click" BorderThickness="0" ToolTip="Клиенты">
                        <Image Source="/Resources/customer.png" Height="30"/>
                    </Button>
                    <Button x:Name="SuppliesBtn" Grid.Row="9" Height="60" Background="White" Click="SuppliesBtn_Click" BorderThickness="0" ToolTip="Поставщики">
                        <Image Source="/Resources/delivery.png" Height="30"/>
                    </Button>
                    <Button x:Name="OrdersBtn" Grid.Row="11" Height="60" Background="White" Click="OrdersBtn_Click" BorderThickness="0" ToolTip="Заказы">
                        <Image Source="/Resources/check_1742953.png" Height="30"/>
                    </Button>
                    <Button x:Name="EmployeesBtn" Grid.Row="13" Height="60" Background="White" Click="EmployeesBtn_Click" BorderThickness="0" ToolTip="Сотрудники">
                        <Image Source="/Resources/teamwork.png" Height="30"/>
                    </Button>
                    <Button x:Name="ExitBtn" Grid.Row="15" Height="60" Background="White" Click="ExitBtn_Click" ToolTip="Выход">
                        <Image Source="/Resources/logout.png" Height="30"/>
                    </Button>
                </Grid>

                <!-- Разделители и кнопка сворачивания -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="7*" />
                    </Grid.RowDefinitions>
                    <Separator Height="Auto" Background="#FF673AB7">
                        <Separator.LayoutTransform>
                            <RotateTransform Angle="90"/>
                        </Separator.LayoutTransform>
                    </Separator>
                    <Separator Grid.Row="2" Height="Auto" Background="#FF673AB7">
                        <Separator.LayoutTransform>
                            <RotateTransform Angle="90"/>
                        </Separator.LayoutTransform>
                    </Separator>
                    <Button Name="MinimizeOrMaximizeBtn" Grid.Row="1" Background="White" Width="20" Height="20" Padding="2" Click="MinimizeOrMaximizeBtn_Click">
                        <Image Source="/Resources/left-arrow.png" Name="ArrowIcon"/>
                    </Button>
                </Grid>

                <!-- Frame для навигации -->
                <Frame Grid.Column="4" Name="MainFrame" NavigationUIVisibility="Hidden" />
            </Grid>
        </Grid>

        <!-- Затемнение и уведомления -->
        <Grid Name="BlurGrid" Background="White" Opacity="0" Visibility="Collapsed" MouseDown="BlurGrid_MouseDown" />
        <Grid Name="NotificationGrid" Visibility="Collapsed" HorizontalAlignment="Right" Grid.Column="1" Background="White"
              Width="400" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TranslateTransform X="300"/>
            </Grid.RenderTransform>

            <Grid.Effect>
                <DropShadowEffect Direction="180" 
                          ShadowDepth="5" 
                          BlurRadius="15" 
                          Opacity="0.3" 
                          Color="Black"/>
            </Grid.Effect>

            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="10" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <TextBlock Text="Уведомления" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="20" FontFamily="{StaticResource GothamProFamily}" Margin="10 0 0 0"/>
            <ListBox Name="NotificationListBox" Grid.Row="2" SelectionChanged="NotificationListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10" MouseEnter="Notification_MouseEnter">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Ellipse HorizontalAlignment="Right" VerticalAlignment="Top" Fill="Red" Height="10" Width="10" 
                                    Visibility="{Binding UnreadVisibility}"/>
                            <TextBlock Grid.Row="0" Text="{Binding Text}" FontFamily="{StaticResource GothamProFamily}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="2" Text="{Binding CreatedAt, Converter={StaticResource RelativeDateConverter}}" 
                             FontFamily="{StaticResource GothamProFamily}" FontSize="15" FontWeight="Light" TextWrapping="Wrap"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Button Name="PreviousNotificationPageBtn" Grid.Column="1" Click="PreviousNotificationPageBtn_Click">
                    <Image Source="/Resources/left-arrow.png" />
                </Button>
                <TextBox Name="PageNumberTextBox" Grid.Column="3" Width="70" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Text="1" FontSize="20" FontFamily="{StaticResource GothamProFamily}"/>
                <Button Name="NextNotificationPageBtn" Grid.Column="5" Click="NextNotificationPageBtn_Click">
                    <Image Source="/Resources/left-arrow.png" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform ScaleX="-1" />
                        </Image.RenderTransform>
                    </Image>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
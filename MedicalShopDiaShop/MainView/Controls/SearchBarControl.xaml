<UserControl x:Class="MedicalShopDiaShop.MainView.Controls.SearchBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="42" d:DesignWidth="400">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid>
            <TextBox x:Name="SearchTextBox"
                     Height="42"
                     FontSize="16"
                     Padding="14,4,14,4"
                     FontFamily="{StaticResource GothamProFamily}"
                     TextChanged="SearchTextBox_OnTextChanged"
                     KeyDown="SearchTextBox_OnKeyDown"/>
            <TextBlock Margin="14,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="16"
                       Foreground="Gray"
                       FontFamily="{StaticResource GothamProLight}"
                       IsHitTestVisible="False"
                       Text="{Binding PlaceholderText, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        <Button Grid.Column="1"
                Width="46"
                Height="42"
                Margin="8,0,0,0"
                Background="White"
                BorderBrush="#FFD1D1D1"
                Click="SearchButton_Click">
            <Image Source="/Resources/search.png"/>
        </Button>
    </Grid>
</UserControl>

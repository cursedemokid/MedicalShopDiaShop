<Window x:Class="MedicalShopDiaShop.MainView.AddEditScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MedicalShopDiaShop.MainView"
        mc:Ignorable="d"
        Title="Расписание" Height="720" Width="1280" MinHeight="400" MinWidth="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid>
        <Image Source="/Resources/BackgroundPatternPurple.png" Stretch="Fill"/>

        <Border CornerRadius="20" BorderThickness="1" BorderBrush="White" Background="White"
                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
            <Grid Width="500">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Заголовок -->
                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" x:Name="TitleText" Text="Новая смена"
                           FontSize="22" FontWeight="Bold" FontFamily="{StaticResource GothamProFamily}"
                           HorizontalAlignment="Center"/>

                <!-- Дата и время начала -->
                <TextBlock Grid.Row="2" Text="Дата начала" FontSize="18" FontFamily="{StaticResource GothamProFamily}"
                           VerticalAlignment="Center"/>
                <Border Grid.Row="2" Grid.Column="2" BorderThickness="1" BorderBrush="Black" CornerRadius="5">
                    <DatePicker x:Name="StartDatePicker" FontSize="18" FontFamily="{StaticResource GothamProFamily}"/>
                </Border>

                <!-- Количество часов -->
                <TextBlock Grid.Row="4" Text="Кол-во часов" FontSize="18" FontFamily="{StaticResource GothamProFamily}"
                           VerticalAlignment="Center"/>
                <Border Grid.Row="4" Grid.Column="2" BorderThickness="1" BorderBrush="Black" CornerRadius="5">
                    <TextBox x:Name="HoursTb" FontSize="18" FontFamily="{StaticResource GothamProFamily}"
                             HorizontalContentAlignment="Left"/>
                </Border>

                <!-- Кнопки -->
                <Grid Grid.Row="8" Grid.ColumnSpan="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" x:Name="SaveBtn" Content="Сохранить" Height="35"
                            Click="SaveBtn_Click" FontSize="18" FontFamily="{StaticResource GothamProFamily}"/>
                    <Button Grid.Column="3" x:Name="CancelBtn" Content="Отмена" Height="35"
                            Click="CancelBtn_Click" FontSize="18" FontFamily="{StaticResource GothamProFamily}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
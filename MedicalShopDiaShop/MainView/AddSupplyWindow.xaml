<Window x:Class="MedicalShopDiaShop.MainView.AddSupplyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MedicalShopDiaShop.MainView"
        mc:Ignorable="d"
        Title="Новая поставка" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Анимация выезда слева (следующий шаг) -->
        <Storyboard x:Key="SlideInFromLeft">
            <DoubleAnimation Storyboard.TargetName="AddSupplyFrame"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="-900" To="0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <!-- Анимация выезда справа (предыдущий шаг) -->
        <Storyboard x:Key="SlideInFromRight">
            <DoubleAnimation Storyboard.TargetName="AddSupplyFrame"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="900" To="0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>
    <Grid>
        <Image Source="/Resources/BackgroundPatternPurple.png" Stretch="Fill"/>

        <Border CornerRadius="20" BorderThickness="1" BorderBrush="White" Background="White" 
                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
            <Grid Width="900" Height="650">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Верхняя панель с навигацией и индикатором шагов -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Кнопка Назад -->
                    <Button x:Name="BackButton" Grid.Column="0" Width="50" Height="50" Background="Transparent" 
                            BorderThickness="0" Click="BackButton_Click" Cursor="Hand" Padding="0">
                        <Image Source="/Resources/left-arrow.png" />
                    </Button>

                    <!-- Текст текущего шага -->
                    <TextBlock x:Name="StepTitleText" Grid.Column="1" Text="Шаг 1: Выбор поставщика" 
                               FontSize="22" FontWeight="Bold" FontFamily="{StaticResource GothamProFamily}" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- Индикатор шагов (три кружка) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Grid>
                            <Ellipse x:Name="Step1Ellipse" Width="60" Height="60" Fill="#FF673AB7" Margin="5"/>
                            <Image Source="/Resources/choice.png" Width="45" Height="45"/>
                        </Grid>

                        <Grid>
                            <Ellipse x:Name="Step2Ellipse" Width="60" Height="60" Fill="LightGray" Margin="5"/>
                            <Image Source="/Resources/clipboard.png" Width="45" Height="45"/>
                        </Grid>

                        <Grid>
                            <Ellipse x:Name="Step3Ellipse" Width="60" Height="60" Fill="LightGray" Margin="5"/>
                            <Image Source="/Resources/delivery.png" Width="45" Height="45"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Frame для страниц шагов с поддержкой анимации -->
                <Frame x:Name="AddSupplyFrame" Grid.Row="2" NavigationUIVisibility="Hidden">
                    <Frame.RenderTransform>
                        <TranslateTransform X="0"/>
                    </Frame.RenderTransform>
                </Frame>
            </Grid>
        </Border>
    </Grid>
</Window>